                                            <ui:Button Click="Previous_Click" ToolTip="Canal o episodio anterior (←)" AutomationProperties.Name="Anterior" MinWidth="30" MinHeight="32" Padding="4,4" Margin="0,0,4,0">
                                                <ui:SymbolIcon Symbol="Previous24" FontSize="14"/>
                                            </ui:Button>
                                            <ui:Button Click="Next_Click" ToolTip="Canal o episodio siguiente (→)" AutomationProperties.Name="Siguiente" MinWidth="30" MinHeight="32" Padding="4,4" Margin="0,0,6,0">
                                                <ui:SymbolIcon Symbol="Next24" FontSize="14"/>
                                            </ui:Button>
                                            <ui:SymbolIcon Symbol="Headphones24" ToolTip="Audio" AutomationProperties.Name="Audio" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextMutedBrush}"/>
                                            <ComboBox x:Name="AudioTrackBox" Width="80" MinHeight="32" ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}" DisplayMemberPath="Name" DropDownClosed="AudioTrack_Changed" AutomationProperties.Name="Pista de audio" Margin="0,0,6,0"/>
                                            <ui:SymbolIcon Symbol="ClosedCaption24" ToolTip="Subtítulos" AutomationProperties.Name="Subtítulos" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextMutedBrush}"/>
                                            <ComboBox x:Name="SubtitleTrackBox" Width="80" MinHeight="32" ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitleTrack}" DisplayMemberPath="Name" DropDownClosed="SubtitleTrack_Changed" AutomationProperties.Name="Subtítulos" Margin="0,0,6,0"/>
                                            <ComboBox Width="62" MinHeight="32" ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" ToolTip="Formato de emisión" AutomationProperties.Name="Formato de reproducción" Margin="0,0,6,0"/>
                                            <ui:Button Click="Retry_Click" ToolTip="Reintentar" AutomationProperties.Name="Reintentar" IsEnabled="{Binding CanRetryPlayback}" MinWidth="30" MinHeight="32" Padding="4,4" Margin="0,0,4,0">
                                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14"/>
                                            </ui:Button>
                                            <ui:Button Click="ToggleFullscreen_Click" ToolTip="Pantalla completa (F o doble clic)" AutomationProperties.Name="Pantalla completa" MinWidth="32" MinHeight="32" Padding="4,4">
                                                <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="14"/>
                                            </ui:Button>
                                        </WrapPanel>
                                    </Grid>
                            </StackPanel>
                                <WrapPanel x:Name="PipControls" Visibility="Collapsed">
                                    <ui:Button Click="TogglePlayPause_Click" ToolTip="{Binding PlayPauseToolTip}" AutomationProperties.Name="{Binding PlayPauseAction}" Margin="0,0,6,0">
                                        <ui:SymbolIcon Symbol="{Binding PlayPauseSymbol}" FontSize="14"/>
                                    </ui:Button>
                                    <ui:Button Content="⏹" Click="Stop_Click" ToolTip="Detener reproducción" AutomationProperties.Name="Detener" IsEnabled="{Binding CanStopPlayback}" Margin="0,0,10,0"/>
                                    <ToggleButton IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="Silenciar o activar sonido" AutomationProperties.Name="Silenciar" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="{Binding MuteSymbol}" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                                    </ToggleButton>
                                    <ui:Button Click="Retry_Click" ToolTip="Reintentar" AutomationProperties.Name="Reintentar" IsEnabled="{Binding CanRetryPlayback}">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14"/>
                                    </ui:Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="8" MaxWidth="760">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="24" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ajustes y cuentas" Style="{StaticResource TypographyPageTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Añadir o actualizar cuenta" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="Nombre para identificarla" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: TV Sala o Mi Proveedor" AutomationProperties.Name="Nombre del perfil"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Text="Dirección del servidor (URL)" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ProfileBaseUrl, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: https://tuservidor.com:8080" AutomationProperties.Name="Servidor base"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="Usuario" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ProfileUsername, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: usuario123" AutomationProperties.Name="Usuario"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Contraseña" FontSize="12" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="ProfilePasswordBox" AutomationProperties.Name="Contraseña" MinHeight="36"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <ui:Button Click="SaveAndWatch_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Guardar y ver TV" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Content="Guardar cuenta" Click="CreateProfile_Click" IsEnabled="{Binding CanConnect}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ProfileStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Mis cuentas guardadas y conexiones" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" MinHeight="56" MaxHeight="140" DisplayMemberPath="Name" AutomationProperties.Name="Cuentas guardadas"/>
                            <WrapPanel Margin="0,10,0,0">
                                <ui:Button Click="UseSelectedProfile_Click" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Tv24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Usar esta cuenta" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Command="{Binding CheckConnectionCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Comprobar conexión" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Command="{Binding DisconnectProfileCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Desconectar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Command="{Binding DeleteProfileCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Eliminar cuenta" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Pantallas:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ActiveConnectionsInfo}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,16,0"/>
                                <TextBlock Text="Vencimiento:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AccountExpirationInfo}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Guardar lista M3U/M3U8 como perfil" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="Nombre del perfil" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding M3uProfileName, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: Lista IPTV Personal" AutomationProperties.Name="Nombre perfil M3U"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Archivo local (.m3u/.m3u8) o URL web (HTTP/HTTPS)" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding M3uProfilePathOrUrl, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: C:\listas\tv.m3u o https://servidor.com/lista.m3u" AutomationProperties.Name="Ruta o URL M3U"/>
                                </StackPanel>
                            </Grid>
                            <ui:Button Click="CreateM3uProfile_Click" IsEnabled="{Binding CanConnect}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Guardar lista como perfil" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Sincronización cifrada (casa y trabajo)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Transfiere tus favoritos e historial entre tus computadoras de forma segura. Se genera un paquete cifrado con tu clave, sin incluir contraseñas ni URLs de cuentas." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Contraseña de cifrado (mínimo 4 caracteres)" FontSize="12" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="SyncPasswordBox" MaxWidth="320" HorizontalAlignment="Left" MinHeight="36" AutomationProperties.Name="Contraseña de sincronización"/>
                            </StackPanel>
                            <WrapPanel>
                                <ui:Button Click="ExportSync_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Exportar sincronización" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Click="ImportSync_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Importar sincronización" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>
                            <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,10,0,0" Visibility="{Binding HasSyncStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Personalización y atajos de teclado" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="Tema:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <ComboBox Width="110" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Margin="0,0,16,6"/>
                                <TextBlock Text="Tamaño interfaz:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <ComboBox Width="110" ItemsSource="{Binding AvailableUiScales}" SelectedItem="{Binding SelectedUiScale, Mode=TwoWay}" Margin="0,0,16,6"/>
                                <TextBlock Text="Idioma:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <ComboBox Width="120" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <Expander Header="Atajos de teclado útiles">
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="• Espacio o K : Reproducir / Pausar" Margin="0,2"/>
                                    <TextBlock Text="• F : Pantalla completa" Margin="0,2"/>
                                    <TextBlock Text="• P : Ventana flotante (PiP)" Margin="0,2"/>
                                    <TextBlock Text="• M : Silenciar / Activar sonido (Mute)" Margin="0,2"/>
                                    <TextBlock Text="• Flechas Arriba / Abajo : Subir / Bajar volumen" Margin="0,2"/>
                                    <TextBlock Text="• Flechas Izquierda / Derecha : Canal anterior / siguiente" Margin="0,2"/>
                                    <TextBlock Text="• Esc : Salir de pantalla completa o ventana flotante" Margin="0,2"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Control parental (protección con PIN)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Protege y oculta categorías para adultos (18+ / Adultos) en TV en vivo, películas y series mediante un PIN numérico seguro de 4 dígitos." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="PIN de 4 a 8 dígitos" FontSize="12" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="ParentalPasswordBox" MaxWidth="220" HorizontalAlignment="Left" MinHeight="36" AutomationProperties.Name="PIN parental"/>
                            </StackPanel>
                            <WrapPanel>
                                <ui:Button Click="ConfigureParental_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Configurar PIN" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Click="UnlockParental_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockOpen24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Desbloquear con PIN" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Click="LockParental_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bloquear ahora" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Content="Desactivar control" Click="DisableParental_Click"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ParentalStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,10,0,0" Visibility="{Binding HasParentalStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Preferencias de reproducción" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <CheckBox x:Name="AutoPlayCheckBox" Content="Al abrir la app, reproducir automáticamente el último canal visto" IsChecked="{Binding AutoPlayLast, Mode=OneWay}" Click="AutoPlay_Click" IsEnabled="{Binding CanFavorite}" Margin="0,0,0,12"/>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="Pantalla completa en:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Width="220" ItemsSource="{Binding Displays, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" SelectedItem="{Binding SelectedDisplay, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Monitor para pantalla completa" Margin="0,0,16,6"/>
                                <CheckBox Content="Modo video compatible (software)" IsChecked="{Binding SoftwareDecoding}" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <TextBlock Text="Estabilidad (ms):" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <TextBox Width="76" Text="{Binding BufferMilliseconds, ValidatesOnExceptions=True}" ToolTip="Tiempo de búfer (ej. 1500 ms)" AutomationProperties.Name="Búfer en milisegundos" Margin="0,0,16,6"/>
                                <TextBlock Text="Amplificación:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <Slider x:Name="AmplificationSlider" Width="96" Minimum="0" Maximum="6" Value="{Binding AmplificationDb, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,8,6" ToolTip="Amplificación segura con preamplificador nativo (0 dB normal, hasta +6 dB)" AutomationProperties.Name="Amplificación de audio en decibelios"/>
                                <TextBlock x:Name="AmplificationValueText" Text="{Binding AmplificationLabel}" VerticalAlignment="Center" MinWidth="84" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Expander Header="Prueba rápida (conectar sin guardar) y copias de seguridad" Margin="0,0,0,14">
                        <StackPanel Margin="8,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="BaseUrlBox" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: https://servidor.com:8080" Margin="0,0,8,8"/>
                                <TextBox Grid.Column="1" x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Tag="Usuario" Margin="0,0,8,8"/>
                                <PasswordBox Grid.Column="2" x:Name="PasswordBox" MinHeight="36" Margin="0,0,0,8"/>
                            </Grid>
                            <WrapPanel Margin="0,4,0,0">
                                <ui:Button Click="Connect_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Conectar ahora" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Click="Backup_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Guardar copia de respaldo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Click="Diagnostics_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Exportar informe de soporte" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="StatusBar" Grid.Row="1" Padding="10" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Margin="0,12,0,0">
                <TextBlock Text="{Binding FooterStatus}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</ui:FluentWindow>

                                            <ToggleButton Grid.Column="2" Style="{StaticResource StarToggle}" Click="FavoriteRow_Click" AutomationProperties.Name="{Binding Name, StringFormat=Favorito: {0}}"
                                                          ToolTip="Guardar en favoritos" IsEnabled="{Binding DataContext.CanFavorite, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <ToggleButton.IsChecked><MultiBinding Converter="{StaticResource FavoriteConverter}" Mode="OneWay">
                                                    <Binding Path="Id"/><Binding Path="DataContext.FavoriteChannelIds" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                                </MultiBinding></ToggleButton.IsChecked>
                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding EmptyMessage}" Visibility="{Binding HasNoChannels, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="12" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,14,0" Visibility="{Binding ShowContinueWatching, Converter={StaticResource BooleanToVisibilityConverter}}">

<ui:FluentWindow x:Class="StreamDesk.Probe.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:lvs="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
                 mc:Ignorable="d"
                 Title="StreamDesk — prueba técnica"
                 Height="800"
                 Width="1280"
                 MinHeight="650"
                 MinWidth="980"
                 WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18" CornerRadius="10" Background="#FF1B1D23" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Servidor base" Margin="0,0,0,5" />
                    <TextBox x:Name="BaseUrlBox"
                             Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="URL http:// o https://, sin credenciales ni parámetros" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Usuario" Margin="0,0,0,5" />
                    <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" MinWidth="190">
                    <TextBlock Text="Contraseña (solo en memoria)" Margin="0,0,0,5" />
                    <DockPanel LastChildFill="False">
                        <PasswordBox x:Name="PasswordBox" Width="128" Margin="0,0,8,0" />
                        <ui:Button Content="Conectar" Click="Connect_Click" MinWidth="90" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="16" CornerRadius="10" Background="#FF1B1D23">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Cuenta y catálogo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding ConnectionSummary}"
                               TextWrapping="Wrap"
                               Foreground="#FFB9C4D0"
                               Margin="0,0,0,10" />
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock Text="Canales en vivo" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button Content="Cargar catálogo" Click="LoadCatalog_Click" DockPanel.Dock="Right" />
                    </DockPanel>
                    <TextBlock Grid.Row="3" Text="Categorías consultadas" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding Categories}"
                             DisplayMemberPath="Name"
                             BorderThickness="0"
                             Background="#FF111318"
                             Margin="0,0,0,10" />
                    <TextBlock Grid.Row="5" Text="Canales en vivo" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ListBox Grid.Row="6"
                             ItemsSource="{Binding Channels}"
                             SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             BorderThickness="0"
                             Background="#FF111318" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="10" Background="#FF050608" ClipToBounds="True">
                    <lvs:VideoView x:Name="VideoView" Loaded="VideoView_Loaded">
                        <Grid Background="#01000000">
                            <TextBlock Text="El video solo se inicia cuando eliges un canal y pulsas Reproducir."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="500"
                                       Foreground="#FFE2E8F0"
                                       FontSize="17"
                                       Margin="24" />
                            <Border VerticalAlignment="Bottom"
                                    Margin="12"
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="#E6101218">
                                <DockPanel LastChildFill="False">
                                    <ui:Button Content="Reproducir seleccionado" Click="PlaySelected_Click" Margin="0,0,8,0" />
                                    <ui:Button Content="Detener" Click="Stop_Click" Margin="0,0,14,0" />
                                    <TextBlock Text="Formato" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Width="90"
                                              ItemsSource="{Binding AvailableFormats}"
                                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />
                                    <ui:Button Content="Pantalla completa" Click="ToggleFullscreen_Click" Margin="14,0,0,0" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </lvs:VideoView>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{Binding HttpWarning}"
                           Visibility="{Binding HasHttpWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Foreground="#FFFFC857"
                           TextWrapping="Wrap"
                           Margin="4,10,4,0" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="#FF1B1D23" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</ui:FluentWindow>

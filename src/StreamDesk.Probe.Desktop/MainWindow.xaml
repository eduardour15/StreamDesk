<ui:FluentWindow x:Class="StreamDesk.Probe.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lvs="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:local="clr-namespace:StreamDesk.Probe.Desktop"
    Title="StreamDesk" Width="1360" Height="850" MinWidth="760" MinHeight="540"
    WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
    <ui:FluentWindow.Resources>
        <local:FavoriteConverter x:Key="FavoriteConverter" />
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#FF15171D"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#FF626B78"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="12,14"/><Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="StarToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Content" Value="☆"/>
            <Setter Property="FontSize" Value="24"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="StarBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="★"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StarBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StarBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid x:Name="Shell" Margin="16" Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="158"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,14,0,26">
                    <TextBlock Text="STREAMDESK" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="TV a tu manera" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,16,0,8">
                    <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <ListBox x:Name="NavigationTabs" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding CurrentTabIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Navegación principal" VerticalAlignment="Top">
                    <ListBoxItem Content="Inicio"/><ListBoxItem Content="TV en vivo"/><ListBoxItem Content="Favoritos"/>
                    <ListBoxItem Content="Recientes"/><ListBoxItem Content="Configuración"/>
                    <ListBoxItem Content="Películas" IsEnabled="{Binding HasMovies}"/><ListBoxItem Content="Series" IsEnabled="{Binding HasSeries}"/>
                    <ListBoxItem Content="Continuar"/>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid x:Name="Workspace" Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="12,24" MaxWidth="840" HorizontalAlignment="Left">
                    <TextBlock Text="Tu próxima señal." FontSize="36" FontWeight="SemiBold"/>
                    <TextBlock Text="Todo lo que ves, en un solo lugar." FontSize="17" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,32"/>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="VOLVER AL ÚLTIMO CANAL" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LastChannelLabel}" FontSize="24" TextWrapping="Wrap" Margin="0,12,0,20"/>
                            <ui:Button Content="Continuar viendo" Click="PlayLast_Click" IsEnabled="{Binding HasLastChannel}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Empieza aquí" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Guarda tu cuenta una vez en Configuración. Después, actualiza el catálogo y elige un canal. Las estrellas y los recientes quedan en este equipo."
                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>
                    <WrapPanel><ui:Button Content="Abrir TV en vivo" Tag="1" Click="Navigate_Click" Margin="0,0,12,8"/>
                        <ui:Button Content="Configurar cuenta" Tag="4" Click="Navigate_Click" Margin="0,0,0,8"/></WrapPanel>
                    <TextBlock Text="Espacio: reproducir / detener · F: pantalla completa · M: silenciar" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,24,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="TvPage" Visibility="{Binding ShowTv, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="TvHeader" Margin="0,4,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding SectionTitle}" Style="{StaticResource TypographyPageTitle}"/>
                        <TextBlock Text="{Binding HeaderSummary}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,8,0"/></StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <ComboBox Width="132" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding ActiveProfile, Mode=TwoWay}" AutomationProperties.Name="Perfil activo" Margin="0,0,8,0"/>
                        <ui:Button Content="Actualizar" Command="{Binding LoadCatalogCommand}" ToolTip="Conectar y actualizar catálogo"/>
                    </WrapPanel>
                </Grid>
                <StackPanel x:Name="ConnectionNotices" Grid.Row="1">
                    <WrapPanel Margin="0,0,0,8"><ui:Button Content="Consultar películas y series" Click="ProbeContent_Click" Margin="0,0,10,0" IsEnabled="{Binding CanConnect}"/>
                        <TextBlock Text="{Binding ContentStatus}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/></WrapPanel>
                    <TextBlock Text="{Binding HttpWarning}" Visibility="{Binding HasHttpWarning, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#FFFFCF72" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8"/>
                    <ui:Button Content="Cancelar consulta" Click="CancelCatalog_Click" Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                </StackPanel>
                <Grid Grid.Row="2" x:Name="TvLayout">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="284"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid x:Name="CatalogPane">
                    <Border Padding="12" CornerRadius="10" Background="{StaticResource SurfaceBrush}" Margin="0,0,14,0" Visibility="{Binding ShowLiveCatalog, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Buscar canal" Margin="0,0,0,6" FontSize="12"/>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar canal"/>
                            </StackPanel>
                            <ComboBox x:Name="CategoryFilter" Grid.Row="1" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" AutomationProperties.Name="Categoría" Margin="0,0,0,8"/>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding FrequentCategories}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Click="Category_Click" Padding="8,4" Margin="0,0,6,6" MaxWidth="180" ToolTip="{Binding Name}"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Grid.Row="3" Margin="0,0,0,8">
                                <TextBlock Text="{Binding ResultSummary}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <Button Content="Limpiar" Click="ClearFilters_Click" DockPanel.Dock="Right" Padding="6,3" HorizontalAlignment="Right" FontSize="12"/>
                            </DockPanel>
                            <Grid Grid.Row="4">
                                <ListBox x:Name="ChannelsList" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="Canales" MouseDoubleClick="Channels_DoubleClick">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Height" Value="56"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource SurfaceRaisedBrush}" Width="32" Height="32" CornerRadius="4">
                                                <local:ChannelLogo Url="{Binding LogoUrl}" Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <ToggleButton Grid.Column="2" Style="{StaticResource StarToggle}" Click="FavoriteRow_Click" AutomationProperties.Name="{Binding Name, StringFormat=Favorito: {0}}"
                                                          ToolTip="Añadir o quitar favorito" IsEnabled="{Binding DataContext.CanFavorite, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <ToggleButton.IsChecked><MultiBinding Converter="{StaticResource FavoriteConverter}" Mode="OneWay">
                                                    <Binding Path="Id"/><Binding Path="DataContext.FavoriteChannelIds" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                                </MultiBinding></ToggleButton.IsChecked>
                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding EmptyMessage}" Visibility="{Binding HasNoChannels, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="12" IsHitTestVisible="False"/>
                            </Grid>
                            <ui:Button Grid.Row="5" Content="Reproducir seleccionado" Click="PlaySelected_Click" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,0,14,0" Visibility="{Binding ShowMediaCatalog, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox Text="{Binding MediaSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar películas o series" ToolTip="Buscar película o serie por nombre" Margin="0,0,0,8"/>
                            <ComboBox Grid.Row="1" ItemsSource="{Binding MediaCategories}" DisplayMemberPath="Name" SelectedItem="{Binding MediaCategory}" AutomationProperties.Name="Categoría de contenido" Margin="0,0,0,8"/>
                            <ListBox Grid.Row="2" x:Name="MediaList" ItemsSource="{Binding MediaItems}" SelectedItem="{Binding SelectedMedia, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Películas o series">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Height" Value="64"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><DockPanel><local:ChannelLogo Width="32" Height="46" Url="{Binding PosterUrl}" Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Expander Grid.Row="3" Header="Ficha y episodios" IsExpanded="True" MaxHeight="300">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SelectedMedia.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding MediaDescription}" TextWrapping="Wrap" MaxHeight="90" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,8"/>
                                    <ComboBox ItemsSource="{Binding Seasons}" DisplayMemberPath="Name" SelectedItem="{Binding Season}" AutomationProperties.Name="Temporada" Visibility="{Binding ShowEpisodePicker, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ListBox ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode}" DisplayMemberPath="Name" MaxHeight="100" AutomationProperties.Name="Episodios" Visibility="{Binding ShowEpisodePicker, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <WrapPanel Margin="0,8,0,0"><ui:Button Content="Ver / reanudar" Click="PlayMedia_Click" Margin="0,0,8,4"/><ui:Button Content="Desde inicio" Click="RestartMedia_Click" Margin="0,0,0,4"/></WrapPanel>
                                </StackPanel></ScrollViewer>
                            </Expander>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,0,14,0" Visibility="{Binding ShowContinueWatching, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel><ui:Button DockPanel.Dock="Bottom" Content="Reanudar seleccionado" Click="PlayMedia_Click" Margin="0,10,0,0"/>
                            <ListBox ItemsSource="{Binding ContinueWatching}" SelectedItem="{Binding SelectedProgress}" DisplayMemberPath="Label" Background="Transparent" AutomationProperties.Name="Continuar viendo"/>
                        </DockPanel>
                    </Border>
                    </Grid>
                    <Grid Grid.Column="1" x:Name="PlayerPane" MouseMove="Player_MouseMove" MouseLeave="Player_MouseLeave">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="NowPlayingTitle" Text="{Binding NowPlaying}" FontSize="20" FontWeight="SemiBold" Margin="4,0,4,12" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Row="1" Background="#FF050608" MinHeight="100" ClipToBounds="True">
                            <Grid>
                                <lvs:VideoView x:Name="VideoView" Loaded="VideoView_Loaded">
                                    <lvs:VideoView.Style><Style TargetType="lvs:VideoView"><Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPlaybackPlaceholder}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                    </Style.Triggers></Style></lvs:VideoView.Style>
                                </lvs:VideoView>
                                <StackPanel VerticalAlignment="Center" Margin="24" Visibility="{Binding ShowPlaybackPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Tu televisión, aquí" FontSize="24" TextAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding PlaybackStatus}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2"><TextBlock x:Name="PlaybackCaption" Text="{Binding PlaybackStatus}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="4,10,4,8" AutomationProperties.LiveSetting="Polite"/>
                            <Expander Header="Guía · ahora y después" Visibility="{Binding ShowLiveCatalog, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="4,0,4,8">
                                <StackPanel Margin="8"><TextBlock Text="{Binding EpgNow}" TextWrapping="Wrap"/><TextBlock Text="{Binding EpgNext}" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBlock Text="{Binding EpgStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,0"><Button Content="Actualizar guía" Click="RefreshEpg_Click" Margin="0,0,8,0"/><Button Content="Importar XMLTV" Click="ImportEpg_Click"/></WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <Border Grid.Row="3" x:Name="PlayerControls" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="10" MouseEnter="Controls_MouseEnter" MouseLeave="Controls_MouseLeave">
                            <StackPanel>
                                <WrapPanel>
                                    <ui:Button Content="Anterior" Click="Previous_Click" ToolTip="Canal anterior (←)" Margin="0,0,6,6"/>
                                    <ui:Button Content="{Binding PlayAction}" Click="TogglePlay_Click" ToolTip="Reproducir o detener (Espacio)" Margin="0,0,6,6"/>
                                    <ui:Button Content="Siguiente" Click="Next_Click" ToolTip="Canal siguiente (→)" Margin="0,0,6,6"/>
                                    <ui:Button Content="Reintentar" Click="Retry_Click" IsEnabled="{Binding CanRetryPlayback}" Margin="0,0,6,6"/>
                                    <ui:Button Content="Pantalla completa" Click="ToggleFullscreen_Click" ToolTip="F · Esc para salir" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock Text="Volumen" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Volumen"/>
                                    <CheckBox Content="Silenciar" IsChecked="{Binding IsMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox Width="74" ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" AutomationProperties.Name="Formato de reproducción"/>
                                </WrapPanel>
                                <Expander Header="Posición y pistas" Margin="0,8,0,0"><StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{Binding PositionLabel}" FontSize="12"/>
                                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonUp="Seek_Completed" KeyUp="Seek_KeyUp" AutomationProperties.Name="Posición del contenido"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <ComboBox x:Name="AudioTrackBox" Width="130" ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}" DisplayMemberPath="Name" AutomationProperties.Name="Pista de audio"/>
                                        <Button Content="Aplicar audio" Click="ApplyAudio_Click" Margin="6,0,10,6"/>
                                        <ComboBox x:Name="SubtitleTrackBox" Width="130" ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitleTrack}" DisplayMemberPath="Name" AutomationProperties.Name="Subtítulos"/>
                                        <Button Content="Aplicar subtítulo" Click="ApplySubtitle_Click" Margin="6,0,0,6"/>
                                    </WrapPanel>
                                    <TextBlock Text="Solo aparecen las pistas que declara el medio. Sin pistas adicionales, no hay selección disponible." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel></Expander>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="8" MaxWidth="780">
                    <TextBlock Text="Configuración" Style="{StaticResource TypographyPageTitle}" Margin="0,0,0,20"/>
                    <WrapPanel Margin="0,0,0,16"><ui:Button Content="Crear copia protegida" Click="Backup_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,12,0"/>
                        <ui:Button Content="Diagnóstico sin datos de cuenta" Click="Diagnostics_Click" IsEnabled="{Binding CanConnect}"/></WrapPanel>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="20" CornerRadius="10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Cuentas guardadas" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" MinHeight="60" MaxHeight="160" DisplayMemberPath="Name" AutomationProperties.Name="Cuentas guardadas"/>
                            <WrapPanel Margin="0,12,0,0"><ui:Button Content="Actualizar" Command="{Binding ReloadProfilesCommand}" Margin="0,0,8,0"/>
                                <ui:Button Content="Eliminar perfil y credenciales" Command="{Binding DeleteProfileCommand}"/></WrapPanel>
                            <TextBlock Text="{Binding ProfileStatus}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Expander Header="Añadir cuenta" IsExpanded="True" Margin="0,0,0,16">
                        <StackPanel Margin="8,16">
                            <TextBlock Text="Un perfil por servidor. Tu contraseña se protege para tu usuario de Windows." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="Nombre del perfil"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nombre del perfil" Margin="0,6,0,12"/>
                            <TextBlock Text="Servidor base"/><TextBox Text="{Binding ProfileBaseUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Servidor base" Margin="0,6,0,12"/>
                            <TextBlock Text="Usuario"/><TextBox Text="{Binding ProfileUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Usuario" Margin="0,6,0,12"/>
                            <TextBlock Text="Contraseña"/><PasswordBox x:Name="ProfilePasswordBox" AutomationProperties.Name="Contraseña" MinHeight="36" Margin="0,6,0,12"/>
                            <ui:Button Content="Guardar perfil" Click="CreateProfile_Click" HorizontalAlignment="Left" IsEnabled="{Binding CanConnect}"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Reproducción y preferencias" IsExpanded="True" Margin="0,0,0,16">
                        <StackPanel Margin="8,16">
                            <TextBlock Text="Perfil de estas preferencias" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding ActiveProfile, Mode=TwoWay}" AutomationProperties.Name="Perfil de preferencias" Margin="0,0,0,12"/>
                            <CheckBox x:Name="AutoPlayCheckBox" Content="Reproducir el último canal al iniciar" IsChecked="{Binding AutoPlayLast, Mode=OneWay}" Click="AutoPlay_Click" IsEnabled="{Binding CanFavorite}"/>
                            <TextBlock Text="Apagado de fábrica. Al activarlo se conectará a este perfil al abrir StreamDesk." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,16"/>
                            <WrapPanel>
                                <TextBlock Text="Búfer (ms)" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Width="80" Text="{Binding BufferMilliseconds, ValidatesOnExceptions=True}" Margin="0,0,16,0" AutomationProperties.Name="Búfer en milisegundos"/>
                                <CheckBox Content="Video por software" IsChecked="{Binding SoftwareDecoding}" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock Text="Búfer de 250 a 10000 ms y decodificador: se aplican al siguiente canal." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,12"/>
                            <ComboBox ItemsSource="{Binding Displays, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" SelectedItem="{Binding SelectedDisplay, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Monitor para pantalla completa"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Conexión temporal · sin guardar" Margin="0,0,0,16">
                        <StackPanel Margin="8,16">
                            <TextBlock Text="Servidor base"/><TextBox x:Name="BaseUrlBox" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
                            <TextBlock Text="Usuario"/><TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>
                            <TextBlock Text="Contraseña"/><PasswordBox x:Name="PasswordBox" MinHeight="36" Margin="0,6,0,12"/>
                            <ui:Button Content="Conectar sin guardar" Click="Connect_Click" IsEnabled="{Binding CanConnect}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="Atajos en TV: Espacio reproduce o detiene; ←/→ cambia canal; ↑/↓ ajusta volumen; F pantalla completa; M silencia; Esc sale de pantalla completa. Se respetan los campos y controles de edición."
                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="StatusBar" Grid.Row="1" Padding="10" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>

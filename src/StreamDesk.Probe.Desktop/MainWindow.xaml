<ui:FluentWindow x:Class="StreamDesk.Probe.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lvs="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:local="clr-namespace:StreamDesk.Probe.Desktop" xmlns:core="clr-namespace:StreamDesk.Probe.Core;assembly=StreamDesk.Probe.Core"
    Title="StreamDesk" Icon="Resources/StreamDesk.ico" Width="1360" Height="850" MinWidth="760" MinHeight="540"
    WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ExtendsContentIntoTitleBar="False" Background="{DynamicResource CanvasBrush}">
    <ui:FluentWindow.Resources>
        <local:FavoriteConverter x:Key="FavoriteConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" Opacity="0.7" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2500D294"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StarToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="StarBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <ui:SymbolIcon x:Name="StarIcon" Symbol="Star24" FontSize="18" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StarIcon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="StarIcon" Property="Filled" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StarBorder" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="StarBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="SearchableCategoryComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="DropDownToggle" ClickMode="Press" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ToggleBorder" Background="#FF15171D" BorderBrush="#FF626B78" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DataContext.SelectedCategory.Name, RelativeSource={RelativeSource AncestorType=ComboBox}, TargetNullValue='Todas las categorías', FallbackValue='Todas las categorías'}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="ToggleBorder" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                       PopupAnimation="Slide" StaysOpen="False">
                    <Border DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="320" Background="#FF1A1D24" BorderBrush="#FF626B78" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.ColumnSpan="3" x:Name="CategoryFilterSearchBox"
                                         Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Buscar categoría..." Padding="26,4,26,4" MinHeight="30" FontSize="12"
                                         AutomationProperties.Name="Buscar categoría"
                                         TextChanged="CategorySearchBox_TextChanged"
                                         PreviewKeyDown="CategorySearchBox_PreviewKeyDown"/>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="7,0,0,0" IsHitTestVisible="False"/>
                                <Button Grid.Column="2" Click="ClearCategorySearch_Click"
                                        Visibility="{Binding HasCategorySearch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="4,2" MinHeight="20"
                                        Background="Transparent" BorderThickness="0" ToolTip="Borrar búsqueda">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="240" CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="SearchableMediaCategoryComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="DropDownToggle" ClickMode="Press" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ToggleBorder" Background="#FF15171D" BorderBrush="#FF626B78" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DataContext.MediaCategory.Name, RelativeSource={RelativeSource AncestorType=ComboBox}, TargetNullValue='Todas las categorías', FallbackValue='Todas las categorías'}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="ToggleBorder" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                       PopupAnimation="Slide" StaysOpen="False">
                    <Border DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="320" Background="#FF1A1D24" BorderBrush="#FF626B78" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.ColumnSpan="3" x:Name="MediaCategoryFilterSearchBox"
                                         Text="{Binding MediaCategorySearch, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Buscar categoría..." Padding="26,4,26,4" MinHeight="30" FontSize="12"
                                         AutomationProperties.Name="Buscar categoría de películas o series"
                                         TextChanged="MediaCategorySearchBox_TextChanged"
                                         PreviewKeyDown="MediaCategorySearchBox_PreviewKeyDown"/>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="7,0,0,0" IsHitTestVisible="False"/>
                                <Button Grid.Column="2" Click="ClearMediaCategorySearch_Click"
                                        Visibility="{Binding HasMediaCategorySearch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="4,2" MinHeight="20"
                                        Background="Transparent" BorderThickness="0" ToolTip="Borrar búsqueda de categoría">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="240" CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="AppTitleBar" Title="StreamDesk" Grid.Row="0" Foreground="{DynamicResource TextPrimaryBrush}" ButtonsForeground="{DynamicResource TextPrimaryBrush}"/>
        <Grid x:Name="Shell" Grid.Row="1" Margin="16" Background="{DynamicResource CanvasBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,10,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Resources/StreamDesk.ico" Width="22" Height="22" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="StreamDesk" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="IPTV Multimedia" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="2,3,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Top" Visibility="{Binding IsCatalogSyncing, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#2000D294" BorderBrush="#5000D294" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0,4,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ProgressBar Width="12" Height="12" IsIndeterminate="True" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sincronizando…" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,10,0,6">
                    <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <ListBox x:Name="NavigationTabs" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding CurrentTabIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Navegación principal" VerticalAlignment="Top">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Tv24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="TV en vivo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Star24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Favoritos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Recientes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ajustes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsEnabled="{Binding HasMovies}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Películas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsEnabled="{Binding HasSeries}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Series" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Continuar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid x:Name="Workspace" Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="16,18,24,24" MaxWidth="1180" HorizontalAlignment="Stretch">
                    <!-- Welcome / Discover Heading -->
                    <TextBlock Text="¿Qué quieres ver hoy?" FontSize="30" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Explora televisión en vivo, películas y series bajo demanda." FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,20"/>

                    <!-- Hero / Last Played Banner -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="14" Padding="24,20" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#2500D294" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="ÚLTIMO CANAL VISTO" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Televisión en directo" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LastChannelLabel}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <WrapPanel>
                                    <ui:Button Click="PlayLast_Click" IsEnabled="{Binding HasLastChannel}"
                                               Appearance="Primary" MinHeight="38" Padding="16,8" Margin="0,0,10,6" ToolTip="Seguir viendo el último canal">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Seguir viendo" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Tag="1" Click="Navigate_Click" MinHeight="38" Padding="14,8" Margin="0,0,10,6" ToolTip="Abrir guía de canales">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Tv24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Canales en vivo" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Tag="4" Click="Navigate_Click" MinHeight="38" Padding="12,8" Margin="0,0,0,6" ToolTip="Administrar cuentas">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Settings24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Configurar cuenta" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Continue Watching Row (when user has in-progress media) -->
                    <StackPanel Visibility="{Binding HasContinueWatching, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,24">
                        <DockPanel Margin="0,0,0,12">
                            <ui:Button Tag="7" Click="Navigate_Click" DockPanel.Dock="Right" Padding="8,4" MinHeight="26" Background="Transparent" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ver todos" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0"/>
                                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </ui:Button>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Continuar viendo" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ContinueWatching}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Height="100" Background="{DynamicResource SurfaceBrush}" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="6" ClipToBounds="True" Background="#FF161A24">
                                                    <local:ChannelLogo Url="{Binding Item.PosterUrl}" Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Height="4" Minimum="0" Maximum="{Binding DurationMilliseconds}" Value="{Binding PositionMilliseconds}" Foreground="{DynamicResource AccentBrush}" Background="#30FFFFFF" Margin="0,8,0,8"/>
                                                    <ui:Button Click="PlayMedia_Click" Padding="8,3" MinHeight="24" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Play24" FontSize="11" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Reanudar" FontSize="11"/>
                                                        </StackPanel>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Quick Navigation Entertainment Cards -->
                    <TextBlock Text="Explora tu contenido" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>
                    <WrapPanel Margin="0,0,0,20">
                        <!-- Películas Card -->
                        <Button Tag="5" Click="Navigate_Click" IsEnabled="{Binding HasMovies}" Style="{StaticResource {x:Type Button}}"
                                Width="260" Height="100" Margin="0,0,14,14" Padding="18,14" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="#25FFFFFF" BorderThickness="1" Cursor="Hand" ToolTip="Explorar catálogo de películas">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Películas" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Cine y estrenos bajo demanda" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="1" Symbol="MoviesAndTv24" FontSize="28" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Series Card -->
                        <Button Tag="6" Click="Navigate_Click" IsEnabled="{Binding HasSeries}" Style="{StaticResource {x:Type Button}}"
                                Width="260" Height="100" Margin="0,0,14,14" Padding="18,14" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="#25FFFFFF" BorderThickness="1" Cursor="Hand" ToolTip="Explorar series y temporadas">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

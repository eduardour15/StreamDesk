                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </Grid>
                            <ComboBox x:Name="CategoryFilter" Grid.Row="1" ItemsSource="{Binding VisibleCategories}" DisplayMemberPath="Name"

                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Guardar copia de respaldo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Click="Diagnostics_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Exportar informe de soporte" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="StatusBar" Grid.Row="1" Padding="10" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Margin="0,12,0,0">
                <TextBlock Text="{Binding FooterStatus}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</ui:FluentWindow>

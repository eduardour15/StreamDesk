                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12" Cursor="Hand" ToolTip="Haz clic para reanudar">

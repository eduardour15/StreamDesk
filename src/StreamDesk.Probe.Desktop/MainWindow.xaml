                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Explorar películas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

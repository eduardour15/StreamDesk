<ui:FluentWindow x:Class="StreamDesk.Probe.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lvs="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:local="clr-namespace:StreamDesk.Probe.Desktop"
    Title="StreamDesk" Width="1360" Height="850" MinWidth="760" MinHeight="540"
    WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ExtendsContentIntoTitleBar="False" Background="{StaticResource CanvasBrush}">
    <ui:FluentWindow.Resources>
        <local:FavoriteConverter x:Key="FavoriteConverter" />
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#FF15171D"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#FF626B78"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" Opacity="0.7" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,11"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="StarToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Content" Value="☆"/>
            <Setter Property="FontSize" Value="22"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="StarBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="★"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StarBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StarBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid x:Name="Shell" Margin="16" Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="158"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,12,0,20">
                    <TextBlock Text="📺 STREAMDESK" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="TV simple y rápida" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,12,0,6">
                    <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <ListBox x:Name="NavigationTabs" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding CurrentTabIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Navegación principal" VerticalAlignment="Top">
                    <ListBoxItem Content="🏠  Inicio"/>
                    <ListBoxItem Content="📺  TV en vivo"/>
                    <ListBoxItem Content="⭐  Favoritos"/>
                    <ListBoxItem Content="🕘  Recientes"/>
                    <ListBoxItem Content="⚙️  Ajustes"/>
                    <ListBoxItem Content="🎬  Películas" IsEnabled="{Binding HasMovies}"/>
                    <ListBoxItem Content="🎞️  Series" IsEnabled="{Binding HasSeries}"/>
                    <ListBoxItem Content="▶️  Continuar"/>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid x:Name="Workspace" Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="12,20" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="¿Qué quieres ver hoy?" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Text="Haz clic en cualquier canal o película para empezar al instante." FontSize="15" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,24"/>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="▶️  ÚLTIMO CANAL VISTO" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LastChannelLabel}" FontSize="22" TextWrapping="Wrap" Margin="0,8,0,16"/>
                            <WrapPanel>
                                <ui:Button Content="▶ Seguir viendo" Click="PlayLast_Click" IsEnabled="{Binding HasLastChannel}" Margin="0,0,10,6"/>
                                <ui:Button Content="📺 Ir a TV en vivo" Tag="1" Click="Navigate_Click" Margin="0,0,10,6"/>
                                <ui:Button Content="⚙️ Configurar cuenta" Tag="4" Click="Navigate_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16" Width="250" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="1️⃣  Añade tu cuenta" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Ej: https://tuservidor.com:8080" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16" Width="250" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="2️⃣  Elige con 1 clic" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Toca cualquier canal para reproducir" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16" Width="250" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="3️⃣  Guarda favoritos ⭐" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Marca tus canales preferidos" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="TvPage" Visibility="{Binding ShowTv, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="TvHeader" Margin="0,4,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding SectionTitle}" Style="{StaticResource TypographyPageTitle}"/>
                        <TextBlock Text="{Binding HeaderSummary}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,8,0"/></StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <ComboBox Width="140" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding ActiveProfile, Mode=TwoWay}" ToolTip="Cambiar cuenta activa" AutomationProperties.Name="Perfil activo" Margin="0,0,8,0"/>
                        <ui:Button Content="🔄 Canales" Command="{Binding LoadCatalogCommand}" ToolTip="Actualizar canales en vivo"/>
                        <ui:Button Content="🎬 Películas/Series" Click="ProbeContent_Click" IsEnabled="{Binding CanConnect}" ToolTip="Cargar catálogo de películas y series" Margin="8,0,0,0"/>
                        <ui:Button x:Name="PipButton" Content="🗗 Flotante" Click="TogglePictureInPicture_Click" IsEnabled="{Binding ShowPlayerPane}" ToolTip="Modo ventana flotante (P)" Margin="8,0,0,0"/>
                    </WrapPanel>
                </Grid>
                <StackPanel x:Name="ConnectionNotices" Grid.Row="1">
                    <TextBlock Text="{Binding HttpWarning}" Visibility="{Binding HasHttpWarning, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#FFFFCF72" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Expander Header="📂 Importar lista M3U/M3U8" Visibility="{Binding ShowLiveCatalog, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,6">
                        <StackPanel Margin="8,4">
                            <TextBlock Text="La lista solo se conserva durante esta sesión. Vuelve a importarla al reiniciar." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <WrapPanel VerticalAlignment="Center">
                                <ui:Button Content="📁 Abrir archivo" Click="ImportPlaylistFile_Click" IsEnabled="{Binding CanImportPlaylist}" Margin="0,0,8,6" ToolTip="Importar un archivo .m3u o .m3u8"/>
                                <TextBox x:Name="RemotePlaylistBox" Text="{Binding RemotePlaylistUrl, UpdateSourceTrigger=PropertyChanged}" Tag="https://ejemplo.com/lista.m3u8" Width="320" MaxWidth="460" UndoLimit="0" AutomationProperties.Name="Dirección de la lista M3U" Margin="0,0,8,6"/>
                                <ui:Button Content="🌐 Importar URL" Click="ImportPlaylistUrl_Click" IsEnabled="{Binding CanImportPlaylist}" Margin="0,0,8,6"/>
                                <TextBlock Text="{Binding PlaylistStatus}" Visibility="{Binding HasPlaylistStatus, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,6"/>
                    <ui:Button Content="✕ Cancelar carga" Click="CancelCatalog_Click" Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                </StackPanel>
                <Grid Grid.Row="2" x:Name="TvLayout">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="284"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid x:Name="CatalogPane">
                    <Border Padding="12" CornerRadius="10" Background="{StaticResource SurfaceBrush}" Margin="0,0,14,0" Visibility="{Binding ShowLiveCatalog, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="🔍 Ej: Deportes, HBO, Noticias..." Padding="10,6,32,6" AutomationProperties.Name="Buscar canal"/>
                                <Button Content="✕" Click="ClearSearch_Click" Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="6,2" MinHeight="24" Background="Transparent" BorderThickness="0" ToolTip="Borrar búsqueda"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <TextBox Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged}" Tag="🔍 Buscar categoría..." Padding="10,6,32,6" AutomationProperties.Name="Buscar categoría"/>
                                <Button Content="✕" Click="ClearCategorySearch_Click" Visibility="{Binding HasCategorySearch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="6,2" MinHeight="24" Background="Transparent" BorderThickness="0" ToolTip="Borrar búsqueda de categoría"/>
                            </Grid>
                            <ComboBox x:Name="CategoryFilter" Grid.Row="2" ItemsSource="{Binding VisibleCategories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" AutomationProperties.Name="Categoría" Margin="0,0,0,8"/>
                            <ItemsControl Grid.Row="3" ItemsSource="{Binding FrequentCategories}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Click="Category_Click" Padding="8,3" Margin="0,0,6,6" MaxWidth="180" FontSize="12" ToolTip="{Binding Name}"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Grid.Row="4" Margin="0,0,0,6">
                                <TextBlock Text="{Binding ResultSummary}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <Button Content="Ver todos" Click="ClearFilters_Click" DockPanel.Dock="Right" Padding="6,2" MinHeight="24" HorizontalAlignment="Right" FontSize="11"/>
                            </DockPanel>
                            <Grid Grid.Row="5">
                                <ListBox x:Name="ChannelsList" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="Canales" PreviewMouseLeftButtonUp="Channels_MouseUp" KeyDown="Channels_KeyDown">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Height" Value="52"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid Margin="4" ToolTip="Clic para reproducir"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource SurfaceRaisedBrush}" Width="32" Height="32" CornerRadius="4">
                                                <local:ChannelLogo Url="{Binding LogoUrl}" Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                                            <ToggleButton Grid.Column="2" Style="{StaticResource StarToggle}" Click="FavoriteRow_Click" AutomationProperties.Name="{Binding Name, StringFormat=Favorito: {0}}"
                                                          ToolTip="Guardar en favoritos" IsEnabled="{Binding DataContext.CanFavorite, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <ToggleButton.IsChecked><MultiBinding Converter="{StaticResource FavoriteConverter}" Mode="OneWay">
                                                    <Binding Path="Id"/><Binding Path="DataContext.FavoriteChannelIds" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                                </MultiBinding></ToggleButton.IsChecked>
                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding EmptyMessage}" Visibility="{Binding HasNoChannels, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="12" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,0,14,0" Visibility="{Binding ShowContinueWatching, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Haz clic en un título para continuar donde lo dejaste:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <ui:Button DockPanel.Dock="Bottom" Content="▶ Reanudar" Click="PlayMedia_Click" Margin="0,10,0,0"/>
                            <ListBox ItemsSource="{Binding ContinueWatching}" SelectedItem="{Binding SelectedProgress}" DisplayMemberPath="Label" Background="Transparent" BorderThickness="0"
                                     AutomationProperties.Name="Continuar viendo" PreviewMouseLeftButtonUp="ContinueWatching_MouseUp"/>
                        </DockPanel>
                    </Border>
                    </Grid>
                    <Border x:Name="MediaBrowsePane" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="18" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                <Grid Width="300" Margin="0,0,8,6">
                                    <TextBox Text="{Binding MediaSearch, UpdateSourceTrigger=PropertyChanged}" Tag="🔍 Buscar título..." Padding="10,6,32,6" AutomationProperties.Name="Buscar películas o series"/>
                                    <Button Content="✕" Click="ClearMediaSearch_Click" Visibility="{Binding HasMediaSearch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="6,2" MinHeight="24" Background="Transparent" BorderThickness="0" ToolTip="Borrar búsqueda"/>
                                </Grid>
                                <Grid Width="260" Margin="0,0,8,6">
                                    <TextBox Text="{Binding MediaCategorySearch, UpdateSourceTrigger=PropertyChanged}" Tag="🔍 Buscar categoría..." Padding="10,6,32,6" AutomationProperties.Name="Buscar categoría de películas o series"/>
                                    <Button Content="✕" Click="ClearMediaCategorySearch_Click" Visibility="{Binding HasMediaCategorySearch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="6,2" MinHeight="24" Background="Transparent" BorderThickness="0" ToolTip="Borrar búsqueda de categoría"/>
                                </Grid>
                                <ComboBox Width="260" ItemsSource="{Binding VisibleMediaCategories}" DisplayMemberPath="Name" SelectedItem="{Binding MediaCategory, Mode=TwoWay}" AutomationProperties.Name="Categoría del catálogo" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <ListBox Grid.Row="1" x:Name="MediaList" ItemsSource="{Binding MediaItems}" SelectedItem="{Binding SelectedMedia, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Películas o series">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Height" Value="104"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,8,8">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" ClipToBounds="True">
                                                <local:ChannelLogo Url="{Binding PosterUrl}" Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,4,4,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="36" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border x:Name="MovieDetailsPane" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,0,14,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <Button Content="←" Click="BackToMediaBrowse_Click" ToolTip="Volver a películas" AutomationProperties.Name="Volver a películas" Padding="8,4" Margin="0,0,8,0"/>
                                <TextBlock Text="Película" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <local:ChannelLogo Width="78" Height="112" Url="{Binding MediaPosterUrl}" Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="UniformToFill" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedMedia.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding MediaCategoryLabel}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding MediaDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </ScrollViewer>
                            <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                                <ui:Button Content="▶" Click="PlayMedia_Click" ToolTip="Reproducir película" AutomationProperties.Name="Reproducir película" Margin="0,0,8,4"/>
                                <ui:Button Content="⏮" Click="RestartMedia_Click" ToolTip="Reproducir desde el inicio" AutomationProperties.Name="Reproducir desde el inicio" Margin="0,0,0,4"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="SeriesDetailsPane" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,0,14,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button Content="←" Click="BackToMediaBrowse_Click" ToolTip="Volver a series" AutomationProperties.Name="Volver a series" Padding="8,4" Margin="0,0,8,0"/>
                                <TextBlock Text="Serie" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <local:ChannelLogo Width="66" Height="92" Url="{Binding MediaPosterUrl}" Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="UniformToFill" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedMedia.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding MediaCategoryLabel}" FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding SeriesSummary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{Binding MediaDescription}" TextWrapping="Wrap" MaxHeight="72" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <ComboBox Grid.Row="0" ItemsSource="{Binding Seasons}" DisplayMemberPath="Name" SelectedItem="{Binding Season, Mode=TwoWay}" AutomationProperties.Name="Temporada" Margin="0,0,0,8"/>
                                <ListBox Grid.Row="1" x:Name="EpisodesList" ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                         AutomationProperties.Name="Episodios" PreviewMouseLeftButtonUp="Episodes_MouseUp" KeyDown="Episodes_KeyDown">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="MinHeight" Value="48"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4" Width="30" Height="30" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Episode}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <TextBlock Grid.Row="4" Text="{Binding ContentStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" x:Name="PlayerPane" MouseMove="Player_MouseMove" MouseLeave="Player_MouseLeave">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel x:Name="NowPlayingTitle" Margin="4,0,4,8">
                            <TextBlock Text="{Binding EpgNow}" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding NowPlaying}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid x:Name="PipHeader" Visibility="Collapsed" Margin="4,0,4,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding NowPlaying}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox x:Name="PipTopmost" Grid.Column="1" Content="📌 Fijar" ToolTip="Mantener siempre visible" AutomationProperties.Name="Siempre visible"
                                      IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ui:Button x:Name="PipReturn" Grid.Column="2" Content="⤢ Volver" Click="TogglePictureInPicture_Click" ToolTip="Volver a ventana normal (Esc)" AutomationProperties.Name="Volver a la ventana normal"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#FF050608" MinHeight="100" ClipToBounds="True" MouseLeftButtonDown="VideoSurface_MouseDown">
                            <Grid>
                                <lvs:VideoView x:Name="VideoView" Loaded="VideoView_Loaded">
                                    <lvs:VideoView.Style><Style TargetType="lvs:VideoView"><Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPlaybackPlaceholder}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                    </Style.Triggers></Style></lvs:VideoView.Style>
                                </lvs:VideoView>
                                <StackPanel VerticalAlignment="Center" Margin="24" Visibility="{Binding ShowPlaybackPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            AutomationProperties.Name="{Binding PlaybackStatus}" AutomationProperties.HelpText="Reproducción detenida.">
                                    <TextBlock Text="📺" FontSize="36" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="PlaybackCaption" Text="{Binding PlaybackStatus}" Visibility="{Binding ShowPlaybackCaption, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="4,6,4,6" AutomationProperties.LiveSetting="Polite"/>
                            <Grid x:Name="EpgPanel">
                                <Expander Header="📅 Programación del canal (ahora y siguiente)" Visibility="{Binding ShowLiveCatalog, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="4,0,4,6">
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding EpgNow}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EpgNext}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,6"/>
                                        <WrapPanel VerticalAlignment="Center">
                                            <Button Content="🔄 Actualizar guía" Click="RefreshEpg_Click" Padding="8,4" Margin="0,0,8,0"/>
                                            <Button Content="📂 Cargar guía (.xml)" Click="ImportEpg_Click" Padding="8,4" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding EpgStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                            </Grid>
                        </StackPanel>
                        <Border Grid.Row="3" x:Name="PlayerControls" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="8" MouseEnter="Controls_MouseEnter" MouseLeave="Controls_MouseLeave">
                            <Grid><StackPanel x:Name="StandardControls">
                                <WrapPanel VerticalAlignment="Center">
                                    <ui:Button Content="⏮" Click="Previous_Click" ToolTip="Canal o episodio anterior (←)" AutomationProperties.Name="Anterior" Margin="0,0,6,4"/>
                                    <ui:Button Content="{Binding PlayActionIcon}" Click="TogglePlay_Click" ToolTip="Reproducir o detener (Espacio)" AutomationProperties.Name="{Binding PlayAction}" Margin="0,0,6,4"/>
                                    <ui:Button Content="⏭" Click="Next_Click" ToolTip="Canal o episodio siguiente (→)" AutomationProperties.Name="Siguiente" Margin="0,0,6,4"/>
                                    <ui:Button Content="🔄" Click="Retry_Click" ToolTip="Reintentar" AutomationProperties.Name="Reintentar" IsEnabled="{Binding CanRetryPlayback}" Margin="0,0,6,4"/>
                                    <ui:Button Content="⛶" Click="ToggleFullscreen_Click" ToolTip="Pantalla completa (F o doble clic)" AutomationProperties.Name="Pantalla completa" Margin="0,0,10,4"/>
                                    <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,8,4" AutomationProperties.Name="Volumen"/>
                                    <CheckBox Content="{Binding MuteIcon}" IsChecked="{Binding IsMuted}" ToolTip="Silenciar o activar sonido" AutomationProperties.Name="Silenciar" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                </WrapPanel>
                                <Expander Header="⚙️" ToolTip="Tiempo, idioma y subtítulos" AutomationProperties.Name="Tiempo, idioma y subtítulos" Margin="0,2,0,0">
                                    <StackPanel Margin="0,6,0,0">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding PositionLabel}" DockPanel.Dock="Right" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonUp="Seek_Completed" KeyUp="Seek_KeyUp" AutomationProperties.Name="Posición del contenido"/>
                                        </DockPanel>
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="🗣️" ToolTip="Audio" AutomationProperties.Name="Audio" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <ComboBox x:Name="AudioTrackBox" Width="130" ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}" DisplayMemberPath="Name" DropDownClosed="AudioTrack_Changed" AutomationProperties.Name="Pista de audio" Margin="0,0,12,4"/>
                                            <TextBlock Text="💬" ToolTip="Subtítulos" AutomationProperties.Name="Subtítulos" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <ComboBox x:Name="SubtitleTrackBox" Width="130" ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitleTrack}" DisplayMemberPath="Name" DropDownClosed="SubtitleTrack_Changed" AutomationProperties.Name="Subtítulos" Margin="0,0,12,4"/>
                                            <ComboBox Width="74" ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" ToolTip="Formato de emisión" AutomationProperties.Name="Formato de reproducción" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                                <WrapPanel x:Name="PipControls" Visibility="Collapsed">
                                    <ui:Button Content="{Binding PlayActionIcon}" Click="TogglePlay_Click" ToolTip="Reproducir o detener (Espacio)" AutomationProperties.Name="{Binding PlayAction}" Margin="0,0,10,0"/>
                                    <CheckBox Content="{Binding MuteIcon}" IsChecked="{Binding IsMuted}" ToolTip="Silenciar o activar sonido" AutomationProperties.Name="Silenciar" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ui:Button Content="🔄" Click="Retry_Click" ToolTip="Reintentar" AutomationProperties.Name="Reintentar" IsEnabled="{Binding CanRetryPlayback}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="8" MaxWidth="760">
                    <TextBlock Text="⚙️ Ajustes y cuentas" Style="{StaticResource TypographyPageTitle}" Margin="0,0,0,16"/>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="➕ Añadir o actualizar cuenta" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="🏷️ Nombre para identificarla" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: TV Sala o Mi Proveedor" AutomationProperties.Name="Nombre del perfil"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Text="🌐 Dirección del servidor (URL)" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ProfileBaseUrl, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: https://tuservidor.com:8080" AutomationProperties.Name="Servidor base"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="👤 Usuario" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ProfileUsername, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: usuario123" AutomationProperties.Name="Usuario"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="🔑 Contraseña" FontSize="12" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="ProfilePasswordBox" AutomationProperties.Name="Contraseña" MinHeight="36"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <ui:Button Content="💾 Guardar y ver TV" Click="SaveAndWatch_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,10,0"/>
                                <ui:Button Content="Guardar cuenta" Click="CreateProfile_Click" IsEnabled="{Binding CanConnect}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ProfileStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="📂 Mis cuentas guardadas y conexiones" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" MinHeight="56" MaxHeight="140" DisplayMemberPath="Name" AutomationProperties.Name="Cuentas guardadas"/>
                            <WrapPanel Margin="0,10,0,0">
                                <ui:Button Content="📺 Usar esta cuenta" Click="UseSelectedProfile_Click" Margin="0,0,8,0"/>
                                <ui:Button Content="🔄 Comprobar conexión" Command="{Binding CheckConnectionCommand}" Margin="0,0,8,0"/>
                                <ui:Button Content="🔌 Desconectar" Command="{Binding DisconnectProfileCommand}" Margin="0,0,8,0"/>
                                <ui:Button Content="🗑 Eliminar cuenta" Command="{Binding DeleteProfileCommand}"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Pantallas:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ActiveConnectionsInfo}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,16,0"/>
                                <TextBlock Text="Vencimiento:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AccountExpirationInfo}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="📋 Guardar lista M3U/M3U8 como perfil" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="Nombre del perfil" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding M3uProfileName, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: Lista IPTV Personal" AutomationProperties.Name="Nombre perfil M3U"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Archivo local (.m3u/.m3u8) o URL web (HTTP/HTTPS)" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding M3uProfilePathOrUrl, UpdateSourceTrigger=PropertyChanged}" Tag="Ej: C:\listas\tv.m3u o https://servidor.com/lista.m3u" AutomationProperties.Name="Ruta o URL M3U"/>
                                </StackPanel>
                            </Grid>
                            <ui:Button Content="💾 Guardar lista como perfil" Click="CreateM3uProfile_Click" IsEnabled="{Binding CanConnect}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🔄 Sincronización cifrada (casa y trabajo)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Transfiere tus favoritos e historial entre tus computadoras de forma segura. Se genera un paquete cifrado con tu clave, sin incluir contraseñas ni URLs de cuentas." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="🔑 Contraseña de cifrado (mínimo 4 caracteres)" FontSize="12" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="SyncPasswordBox" MaxWidth="320" HorizontalAlignment="Left" MinHeight="36" AutomationProperties.Name="Contraseña de sincronización"/>
                            </StackPanel>
                            <WrapPanel>
                                <ui:Button Content="📤 Exportar sincronización" Click="ExportSync_Click" Margin="0,0,10,0"/>
                                <ui:Button Content="📥 Importar sincronización" Click="ImportSync_Click"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,10,0,0" Visibility="{Binding HasSyncStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🎨 Personalización y atajos de teclado" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="Tema:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <ComboBox Width="110" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Margin="0,0,16,6"/>
                                <TextBlock Text="Tamaño interfaz:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <ComboBox Width="110" ItemsSource="{Binding AvailableUiScales}" SelectedItem="{Binding SelectedUiScale, Mode=TwoWay}" Margin="0,0,16,6"/>
                                <TextBlock Text="Idioma:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <ComboBox Width="120" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <Expander Header="⌨️ Atajos de teclado útiles">
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="• Espacio o K : Reproducir / Pausar" Margin="0,2"/>
                                    <TextBlock Text="• F : Pantalla completa" Margin="0,2"/>
                                    <TextBlock Text="• P : Ventana flotante (PiP)" Margin="0,2"/>
                                    <TextBlock Text="• M : Silenciar / Activar sonido (Mute)" Margin="0,2"/>
                                    <TextBlock Text="• Flechas Arriba / Abajo : Subir / Bajar volumen" Margin="0,2"/>
                                    <TextBlock Text="• Flechas Izquierda / Derecha : Canal anterior / siguiente" Margin="0,2"/>
                                    <TextBlock Text="• Esc : Salir de pantalla completa o ventana flotante" Margin="0,2"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🔒 Control parental (protección con PIN)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Protege y oculta categorías para adultos (18+ / Adultos) en TV en vivo, películas y series mediante un PIN numérico seguro de 4 dígitos." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="🔢 PIN de 4 a 8 dígitos" FontSize="12" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="ParentalPasswordBox" MaxWidth="220" HorizontalAlignment="Left" MinHeight="36" AutomationProperties.Name="PIN parental"/>
                            </StackPanel>
                            <WrapPanel>
                                <ui:Button Content="🔐 Configurar PIN" Click="ConfigureParental_Click" Margin="0,0,10,0"/>
                                <ui:Button Content="🔓 Desbloquear con PIN" Click="UnlockParental_Click" Margin="0,0,10,0"/>
                                <ui:Button Content="🔒 Bloquear ahora" Click="LockParental_Click" Margin="0,0,10,0"/>
                                <ui:Button Content="Desactivar control" Click="DisableParental_Click"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ParentalStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,10,0,0" Visibility="{Binding HasParentalStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🎛️ Preferencias de reproducción" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <CheckBox x:Name="AutoPlayCheckBox" Content="Al abrir la app, reproducir automáticamente el último canal visto" IsChecked="{Binding AutoPlayLast, Mode=OneWay}" Click="AutoPlay_Click" IsEnabled="{Binding CanFavorite}" Margin="0,0,0,12"/>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="🖥 Pantalla completa en:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <ComboBox Width="220" ItemsSource="{Binding Displays, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" SelectedItem="{Binding SelectedDisplay, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Monitor para pantalla completa" Margin="0,0,16,6"/>
                                <CheckBox Content="Modo video compatible (software)" IsChecked="{Binding SoftwareDecoding}" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <TextBlock Text="Estabilidad (ms):" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <TextBox Width="76" Text="{Binding BufferMilliseconds, ValidatesOnExceptions=True}" ToolTip="Tiempo de búfer (ej. 1500 ms)" AutomationProperties.Name="Búfer en milisegundos" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Expander Header="⚡ Prueba rápida (conectar sin guardar) y copias de seguridad" Margin="0,0,0,14">
                        <StackPanel Margin="8,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="BaseUrlBox" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Tag="🌐 Ej: https://servidor.com:8080" Margin="0,0,8,8"/>
                                <TextBox Grid.Column="1" x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Tag="👤 Usuario" Margin="0,0,8,8"/>
                                <PasswordBox Grid.Column="2" x:Name="PasswordBox" MinHeight="36" Margin="0,0,0,8"/>
                            </Grid>
                            <WrapPanel Margin="0,4,0,0">
                                <ui:Button Content="⚡ Conectar ahora" Click="Connect_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,12,6"/>
                                <ui:Button Content="📦 Guardar copia de respaldo" Click="Backup_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,8,6"/>
                                <ui:Button Content="🩺 Exportar informe de soporte" Click="Diagnostics_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="StatusBar" Grid.Row="1" Padding="10" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Margin="0,12,0,0">
                <TextBlock Text="{Binding FooterStatus}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>

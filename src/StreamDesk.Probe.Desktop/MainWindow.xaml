<ui:FluentWindow x:Class="StreamDesk.Probe.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:lvs="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
                 xmlns:local="clr-namespace:StreamDesk.Probe.Desktop"
                 Title="StreamDesk"
                 Height="850" Width="1360" MinHeight="680" MinWidth="1000"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource CanvasBrush}">
    <ui:FluentWindow.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#FF15171D" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#FF414550" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Margin="{StaticResource SpaceLarge}" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,18">
            <StackPanel>
                <TextBlock Text="STREAMDESK" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Televisión, organizada a tu manera" FontSize="21" FontWeight="SemiBold" />
            </StackPanel>
            <ProgressBar DockPanel.Dock="Right" Width="110" Height="5" IsIndeterminate="True"
                         Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}"
                         VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
        </DockPanel>

        <TabControl x:Name="NavigationTabs" Grid.Row="1" SelectedIndex="{Binding CurrentTabIndex, Mode=TwoWay}" Background="{StaticResource CanvasBrush}" BorderThickness="0">
            <TabItem Header="Inicio">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tu espacio de reproducción" Style="{StaticResource TypographyHero}" />
                    <TextBlock Grid.Row="1" Text="La aplicación está lista para trabajar sin conexión. Administra un perfil local desde Configuración o abre TV en vivo para la prueba de reproducción."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="15" TextWrapping="Wrap" MaxWidth="760" Margin="0,10,0,24" />
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22" VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Estado local" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="Los perfiles y el esquema de catálogo se guardan en tu carpeta de usuario. Las credenciales se cifran con DPAPI CurrentUser y se mantienen fuera de SQLite."
                                       TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="TV en vivo">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="16" CornerRadius="10" Background="{StaticResource SurfaceBrush}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <TextBlock Text="Perfil" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="200" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding ActiveProfile, Mode=TwoWay}" Margin="0,0,8,0" />
                                <ui:Button Content="Conectar perfil" Command="{Binding ConnectProfileCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Actualizar catálogo" Command="{Binding LoadCatalogCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Cancelar consulta" Click="CancelCatalog_Click" />
                            </WrapPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Conexión temporal · servidor base" Margin="0,0,0,5" />
                                <TextBox x:Name="BaseUrlBox" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="URL http:// o https://, sin credenciales ni parámetros" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Usuario" Margin="0,0,0,5" />
                                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" MinWidth="210">
                                <TextBlock Text="Contraseña (se usa en memoria)" Margin="0,0,0,5" />
                                <DockPanel LastChildFill="False">
                                    <PasswordBox x:Name="PasswordBox" Width="128" Margin="0,0,8,0" />
                                    <ui:Button Content="Conectar" Click="Connect_Click" MinWidth="80" IsEnabled="{Binding CanConnect}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="16" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="Cuenta y catálogo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Text="{Binding ConnectionSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" Visibility="{Binding HasConnectionSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                    <TextBlock Text="Buscar canal" Margin="0,0,0,5" />
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar canal" ToolTip="Sin distinguir acentos ni mayúsculas" />
                                </StackPanel>
                                <ComboBox x:Name="CategoryFilter" Grid.Row="3" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Margin="0,0,0,8" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                                <CheckBox Grid.Row="4" Content="Solo favoritos guardados" IsChecked="{Binding FavoritesOnly}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="5" Text="{Binding CatalogSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" FontSize="12" />
                                <Grid Grid.Row="6">
                                    <ListBox x:Name="ChannelsList" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" BorderThickness="0" Background="#FF111318"
                                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Height" Value="52" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <DockPanel Margin="4" Height="42">
                                                <Border Width="40" Height="36" Background="{StaticResource SurfaceRaisedBrush}" Margin="0,0,8,0">
                                                    <local:ChannelLogo Url="{Binding LogoUrl}" Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Sin canales. Actualiza el catálogo o cambia los filtros." TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="18" IsHitTestVisible="False" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding HasNoChannels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="10" Background="#FF050608" ClipToBounds="True">
                                <lvs:VideoView x:Name="VideoView" Loaded="VideoView_Loaded">
                                    <Grid Background="#01000000">
                                        <TextBlock Text="El video solo se inicia cuando eliges un canal y pulsas Reproducir." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="500" Foreground="#FFE2E8F0" FontSize="17" Margin="24" />
                                        <Border VerticalAlignment="Bottom" Margin="12" Padding="10" CornerRadius="8" Background="#E6101218">
                                            <DockPanel LastChildFill="False">
                                                <ui:Button Content="Reproducir seleccionado" Click="PlaySelected_Click" Margin="0,0,8,0" />
                                                <ui:Button Content="Detener" Click="Stop_Click" Margin="0,0,14,0" />
                                                <TextBlock Text="Formato" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox Width="90" ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" />
                                                <ui:Button Content="Pantalla completa" Click="ToggleFullscreen_Click" Margin="14,0,0,0" />
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                </lvs:VideoView>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding HttpWarning}" Visibility="{Binding HasHttpWarning, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#FFFFC857" TextWrapping="Wrap" Margin="4,10,4,0" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Favoritos">
                <Grid Margin="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                        <TextBlock Text="Tus favoritos" Style="{StaticResource TypographyPageTitle}" TextAlignment="Center" />
                        <TextBlock Text="La base local ya tiene el espacio versionado para favoritos. Añadir canales desde el catálogo llega en la fase de contenido."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Recientes">
                <Grid Margin="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                        <TextBlock Text="Reproducciones recientes" Style="{StaticResource TypographyPageTitle}" TextAlignment="Center" />
                        <TextBlock Text="El historial local está preparado; se poblará cuando el flujo de reproducción se integre con la persistencia."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Configuración">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Perfiles" Style="{StaticResource TypographyPageTitle}" />
                        <TextBlock Text="Se guarda la dirección base y se cifran usuario y contraseña con DPAPI CurrentUser. No se almacenan credenciales en la base de datos."
                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,20" />
                        <TextBlock Text="Crea un perfil independiente por servidor. La aplicación no intercambia servidores automáticamente." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Nombre del perfil" Margin="0,0,0,5" /><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Servidor base" Margin="0,14,0,5" /><TextBox Text="{Binding ProfileBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Usuario" Margin="0,14,0,5" /><TextBox Text="{Binding ProfileUsername, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Contraseña" Margin="0,14,0,5" /><PasswordBox x:Name="ProfilePasswordBox" MinHeight="36" Padding="10,6" />
                        <ui:Button Content="Guardar perfil" Click="CreateProfile_Click" HorizontalAlignment="Left" Margin="0,18,0,0" />
                        <TextBlock Text="{Binding ProfileStatus}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Cuentas guardadas" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button Content="Actualizar" Command="{Binding ReloadProfilesCommand}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" MinHeight="240" Background="#FF111318" BorderThickness="0">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding BaseUrl}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <ui:Button Content="Eliminar perfil y credenciales" Command="{Binding DeleteProfileCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            <TextBlock Text="La eliminación borra el registro local y el archivo protegido asociado a tu usuario de Windows." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="{StaticResource SurfaceBrush}" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</ui:FluentWindow>

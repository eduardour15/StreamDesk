                                    <TextBlock Text="{Binding SelectedMedia.Name}" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                    <Border Background="#2000D294" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding MediaCategoryLabel}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding SeriesSummary}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{Binding MediaDescription}" TextWrapping="Wrap" MaxHeight="64" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <ComboBox ItemsSource="{Binding Seasons}" DisplayMemberPath="Name" SelectedItem="{Binding Season, Mode=TwoWay}" AutomationProperties.Name="Temporada" Margin="0,0,0,8"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <ui:Button x:Name="PlayRandomEpisodeButton" Click="PlayRandomEpisode_Click" IsEnabled="{Binding CanPlayRandomEpisode}" ToolTip="Elegir y reproducir un episodio al azar de esta serie" AutomationProperties.Name="Episodio al azar" Padding="12,5" Margin="0,0,10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Episodio al azar" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ui:Button>
                                        <CheckBox x:Name="RandomNextEpisodeCheckBox" Content="Siguiente episodio al azar" IsChecked="{Binding AutoRandomNextEpisode, Mode=TwoWay}" ToolTip="Al terminar un episodio, reproducir otro al azar automáticamente" AutomationProperties.Name="Siguiente episodio al azar" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                </StackPanel>
                                <ListBox Grid.Row="1" x:Name="EpisodesList" ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                         AutomationProperties.Name="Episodios" PreviewMouseLeftButtonUp="Episodes_MouseUp" KeyDown="Episodes_KeyDown">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="MinHeight" Value="52"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Background="#2500D294" CornerRadius="4" Width="34" Height="34" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Episode}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="13"/>
                                                <ui:SymbolIcon Grid.Column="2" Symbol="Play24" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <TextBlock Grid.Row="4" Text="{Binding ContentStatus}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" x:Name="PlayerPane" MouseMove="Player_MouseMove" MouseLeave="Player_MouseLeave">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel x:Name="NowPlayingTitle" Margin="4,0,4,8">
                            <TextBlock Text="{Binding EpgNow}" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                            <ui:Button x:Name="BackToEpisodesButton" DockPanel.Dock="Left" Click="BackToEpisodes_Click"
                                       Visibility="{Binding IsImmersiveMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       ToolTip="{Binding ImmersiveReturnLabel}" AutomationProperties.Name="{Binding ImmersiveReturnLabel}"
                                       FontWeight="SemiBold" Padding="10,4" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ImmersiveReturnLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <TextBlock Text="{Binding NowPlaying}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Grid.Row="1" x:Name="VideoSurface" Background="#FF050608" ClipToBounds="True">
                            <!-- VideoView.Content uses LibVLCSharp's owned transparent foreground HWND. -->
                            <lvs:VideoView x:Name="VideoView" Loaded="VideoView_Loaded">
                                <!-- Alpha 1 keeps empty pixels hit-testable in the layered HWND (alpha 0 passes input to native video). -->
                                <Grid x:Name="PlayerOverlay" Background="#01000000" Focusable="True" Cursor="Arrow" ForceCursor="True"
                                    Loaded="PlayerOverlay_Loaded" PreviewKeyDown="WindowKeyDown"
                                    PreviewMouseDown="Overlay_MouseDown" MouseMove="Player_MouseMove" MouseLeave="Player_MouseLeave"
                                    PreviewTouchDown="VideoSurface_TouchDown">
                                    <Grid.Resources>
                                        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F4F7"/>
                                        <SolidColorBrush x:Key="TextMutedBrush" Color="#FFD0D6E0"/>
                                        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF232630"/>

                                        <!-- Modern Player Progress Slider Style -->
                                        <Style x:Key="PlayerProgressSliderStyle" TargetType="Slider">
                                            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Focusable" Value="True"/>
                                            <Setter Property="IsMoveToPointEnabled" Value="True"/>
                                            <Setter Property="MinHeight" Value="24"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Slider">
                                                        <Grid VerticalAlignment="Center">
                                                            <Border Height="24" Background="Transparent"/>
                                                            <Border x:Name="TrackBackground" Height="5" Background="#35FFFFFF" CornerRadius="2.5" VerticalAlignment="Center"/>
                                                            <Track x:Name="PART_Track" Height="24">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                                                        <RepeatButton.Template>
                                                                            <ControlTemplate TargetType="RepeatButton">
                                                                                <Border Height="5" Background="{DynamicResource AccentBrush}" CornerRadius="2.5" VerticalAlignment="Center"/>
                                                                            </ControlTemplate>
                                                                        </RepeatButton.Template>
                                                                    </RepeatButton>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.Thumb>
                                                                    <Thumb x:Name="Thumb">
                                                                        <Thumb.Template>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Grid Width="20" Height="20">
                                                                                    <Ellipse x:Name="ThumbGlow" Width="18" Height="18" Fill="{DynamicResource AccentBrush}" Opacity="0.3" Visibility="Collapsed"/>
                                                                                    <Ellipse x:Name="ThumbInner" Width="14" Height="14" Fill="#FFFFFF">
                                                                                        <Ellipse.Effect>
                                                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.6"/>
                                                                                        </Ellipse.Effect>
                                                                                    </Ellipse>
                                                                                </Grid>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="ThumbGlow" Property="Visibility" Value="Visible"/>
                                                                                        <Setter TargetName="ThumbInner" Property="Width" Value="16"/>
                                                                                        <Setter TargetName="ThumbInner" Property="Height" Value="16"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsDragging" Value="True">
                                                                                        <Setter TargetName="ThumbGlow" Property="Visibility" Value="Visible"/>
                                                                                        <Setter TargetName="ThumbInner" Property="Width" Value="16"/>
                                                                                        <Setter TargetName="ThumbInner" Property="Height" Value="16"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Thumb.Template>
                                                                    </Thumb>
                                                                </Track.Thumb>
                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                                                        <RepeatButton.Template>
                                                                            <ControlTemplate TargetType="RepeatButton">
                                                                                <Border Height="5" Background="Transparent" VerticalAlignment="Center"/>
                                                                            </ControlTemplate>
                                                                        </RepeatButton.Template>
                                                                    </RepeatButton>
                                                                </Track.IncreaseRepeatButton>
                                                            </Track>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="TrackBackground" Property="Height" Value="6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- Modern Full-Width Track Option Button Style -->
                                        <Style x:Key="TrackOptionButtonStyle" TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="#D0D6E0"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="MinHeight" Value="38"/>
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="OptionBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="OptionBorder" Property="Background" Value="#25FFFFFF"/>
                                                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#40FFFFFF"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="OptionBorder" Property="Background" Value="#1AFFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="OptionBorder" Property="Background" Value="#38FFFFFF"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="OptionBorder" Property="Background" Value="#203B82F6"/>
                                                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#703B82F6"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- Netflix-style Episode Drawer Card Button Style -->
                                        <Style x:Key="DrawerEpisodeCardStyle" TargetType="Button">
                                            <Setter Property="Background" Value="#1C202B"/>
                                            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="MinHeight" Value="82"/>
                                            <Setter Property="Padding" Value="10"/>
                                            <Setter Property="Margin" Value="0,0,6,10"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="CardBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CardBorder" Property="Background" Value="#2A303F"/>
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#60FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="CardBorder" Property="Background" Value="#353D50"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter TargetName="CardBorder" Property="Background" Value="#26005A9E"/>
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Grid.Resources>
                                    <StackPanel VerticalAlignment="Center" Margin="24" Visibility="{Binding ShowPlaybackPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="{Binding PlaybackStatus}" AutomationProperties.HelpText="Reproducción detenida.">
                                        <ui:SymbolIcon Symbol="Tv24" FontSize="48" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="#D9000000" CornerRadius="8" Padding="18,10"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ShowOsd, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        IsHitTestVisible="False">
                                        <TextBlock Text="{Binding OsdText}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextAlignment="Center"/>
                                    </Border>
                                    <Grid x:Name="PipHeader" Visibility="Collapsed" VerticalAlignment="Top" Margin="8" Background="#E610141D">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding NowPlaying}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <CheckBox x:Name="PipTopmost" Grid.Column="1" ToolTip="Mantener siempre visible" AutomationProperties.Name="Siempre visible"
                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Pin24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Fijar" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <ui:Button x:Name="PipReturn" Grid.Column="2" Click="TogglePictureInPicture_Click" ToolTip="Volver a ventana normal (Esc)" AutomationProperties.Name="Volver a la ventana normal">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="PictureInPicture24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Volver" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>
                                    <!-- Subtle Bottom Vignette Gradient to boost legibility over bright video -->
                                    <Border VerticalAlignment="Bottom" Height="220" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.0"/>
                                                <GradientStop Color="#5505080E" Offset="0.4"/>
                                                <GradientStop Color="#E605080E" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel x:Name="PlayerChrome" VerticalAlignment="Bottom" Margin="16,0,16,14">
                                        <Grid>
                                            <Border x:Name="VideoLoadingIndicator" Background="#E610141D" CornerRadius="6" Padding="10,6" Margin="4,6,4,2"
                                                Visibility="{Binding IsVideoLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="{Binding VideoLoadingMessage}" AutomationProperties.LiveSetting="Polite">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="VideoLoadingText" Text="{Binding VideoLoadingMessage}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <ProgressBar x:Name="VideoLoadingProgress" Height="6" Minimum="0" Maximum="100"
                                                    Grid.Column="1"
                                                    Value="{Binding VideoBufferPercent, Mode=OneWay}"
                                                    IsIndeterminate="{Binding IsVideoLoadingIndeterminate, Mode=OneWay}"
                                                    VerticalAlignment="Center" AutomationProperties.Name="Progreso de carga del vídeo"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="PlaybackCaption" Background="#CC10141D" Text="{Binding PlaybackStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="4,6,4,6" AutomationProperties.LiveSetting="Polite">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowPlaybackCaption}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsVideoLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Border x:Name="PlayerControls" Background="#E60D1017" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,4,0,0" MouseEnter="Controls_MouseEnter" MouseLeave="Controls_MouseLeave" PreviewTouchDown="Controls_TouchDown">
                                            <Grid>
                                                <StackPanel x:Name="StandardControls">
                                                    <!-- VOD Progress Bar Row (when CanSeek is true) -->
                                                    <Grid Margin="0,0,0,6" Visibility="{Binding CanSeek, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Hover Scrub Preview Badge Canvas -->
                                                        <Canvas Grid.Row="0" Height="22" ClipToBounds="False">
                                                            <Border x:Name="SeekPreviewBadge"
                                                                    Background="#F010141D" BorderBrush="#50FFFFFF" BorderThickness="1"
                                                                    CornerRadius="4" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
                                                                <TextBlock x:Name="SeekPreviewText" Text="00:00:00" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                        </Canvas>

                                                        <!-- Time Labels and Slider -->
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider x:Name="SeekSlider" Grid.Column="0"
                                                                    Style="{StaticResource PlayerProgressSliderStyle}"
                                                                    Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                                                    IsEnabled="{Binding CanSeek}"
                                                                    PreviewMouseLeftButtonDown="Seek_MouseDown"
                                                                    PreviewMouseLeftButtonUp="Seek_Completed"
                                                                    KeyUp="Seek_KeyUp"
                                                                    MouseMove="SeekSlider_MouseMove"
                                                                    MouseLeave="SeekSlider_MouseLeave"
                                                                    AutomationProperties.Name="Posición del contenido"
                                                                    Margin="0,0,14,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding PositionLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Live TV Indicator Bar (when CanSeek is false) -->
                                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6" Visibility="{Binding IsLivePlayback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border Background="#25E50914" BorderBrush="#80E50914" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="8" Height="8" Fill="#E50914" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="EN VIVO" FontWeight="Bold" FontSize="11" Foreground="#FF4D4D" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="Transmisión en directo" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Media Title -->
                                                    <TextBlock x:Name="ControlsMediaTitle" Text="{Binding NowPlaying}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NowPlaying}" Margin="2,0,2,6"/>

                                                    <!-- Main Controls Bar: Left Group and Right Group -->
                                                    <DockPanel LastChildFill="False">
                                                        <!-- Left Group: Playback & Volume -->
                                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button x:Name="PlayPauseButton" Click="TogglePlayPause_Click" ToolTip="{Binding PlayPauseToolTip}" AutomationProperties.Name="{Binding PlayPauseAction}"
                                                                       MinWidth="38" MinHeight="36" Padding="6,4" Margin="0,0,6,0">
                                                                <ui:SymbolIcon Symbol="{Binding PlayPauseSymbol}" FontSize="17"/>
                                                            </ui:Button>
                                                            <ui:Button x:Name="SeekBackwardButton" Content="↺10" Click="SeekBackward_Click" IsEnabled="{Binding CanSeek}"
                                                                       ToolTip="Retroceder 10 segundos (J / 🠔)" AutomationProperties.Name="Retroceder 10 segundos"
                                                                       MinWidth="34" MinHeight="36" Padding="4" Margin="0,0,4,0"/>
                                                            <ui:Button x:Name="SeekForwardButton" Content="↻10" Click="SeekForward_Click" IsEnabled="{Binding CanSeek}"
                                                                       ToolTip="Adelantar 10 segundos (L / ➔)" AutomationProperties.Name="Adelantar 10 segundos"
                                                                       MinWidth="34" MinHeight="36" Padding="4" Margin="0,0,6,0"/>
                                                            <ui:Button x:Name="StopButton" Content="⏹" Click="Stop_Click" ToolTip="Detener reproducción" AutomationProperties.Name="Detener"
                                                                       IsEnabled="{Binding CanStopPlayback}" MinWidth="32" MinHeight="36" Padding="4" Margin="0,0,8,0"/>

                                                            <Rectangle Width="1" Fill="#20FFFFFF" Margin="0,6,8,6"/>

                                                            <!-- Volume and Mute -->
                                                            <ToggleButton IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="Silenciar o activar sonido (M)" AutomationProperties.Name="Silenciar"
                                                                          Background="Transparent" BorderThickness="0" MinWidth="32" MinHeight="36" Padding="4" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                <ui:SymbolIcon Symbol="{Binding MuteSymbol}" FontSize="16" Foreground="{DynamicResource TextMutedBrush}"/>
                                                            </ToggleButton>
                                                            <Slider x:Name="VolumeSlider" Width="76" Minimum="0" Maximum="400" Value="{Binding Volume, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="False"
                                                                    VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Volumen (↑/↓: 5 puntos, hasta 100%; Sound Booster manual hasta 400%)" AutomationProperties.Name="Volumen"/>
                                                            <TextBlock x:Name="VolumePercentageText" Text="{Binding VolumeLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MinWidth="34" AutomationProperties.Name="Porcentaje de volumen"/>
                                                        </StackPanel>

                                                        <!-- Right Group: Options, Navigation, Fullscreen -->
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Audio and Subtitles Button -->
                                                            <ui:Button x:Name="AudioSubtitlesButton" Click="ToggleAudioSubtitles_Click" ToolTip="Audio y subtítulos (S)" AutomationProperties.Name="Audio y subtítulos"
                                                                       MinHeight="36" Padding="8,4" Margin="0,0,6,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="ClosedCaption24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Audio y subs" FontSize="12" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </ui:Button>

                                                            <!-- In-Player Seasons & Episodes Drawer Button (Netflix style) -->
                                                            <ui:Button x:Name="EpisodesDrawerButton" Click="ToggleEpisodesDrawer_Click"
                                                                       Visibility="{Binding CanBrowseEpisodes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                       ToolTip="Temporadas y episodios (E)" AutomationProperties.Name="Selector de episodios de la serie"
                                                                       MinHeight="36" Padding="8,4" Margin="0,0,6,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Episodios" FontSize="12" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </ui:Button>

                                                            <!-- Episode / Channel Navigation -->
                                                            <ui:Button x:Name="EpisodeReturnControl" Click="BackToEpisodes_Click"
                                                                       Visibility="{Binding IsImmersiveMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                       ToolTip="{Binding ImmersiveReturnLabel}" AutomationProperties.Name="{Binding ImmersiveReturnLabel}"
                                                                       MinWidth="32" MinHeight="36" Padding="4" Margin="0,0,4,0">
                                                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="15"/>
                                                            </ui:Button>
                                                            <ui:Button Click="Previous_Click" ToolTip="Canal o episodio anterior (Shift+P)" AutomationProperties.Name="Anterior"
                                                                       MinWidth="32" MinHeight="36" Padding="4" Margin="0,0,4,0">
                                                                <ui:SymbolIcon Symbol="Previous24" FontSize="15"/>
                                                            </ui:Button>
                                                            <ui:Button Click="Next_Click" ToolTip="Canal o episodio siguiente (Shift+N)" AutomationProperties.Name="Siguiente"
                                                                       MinWidth="32" MinHeight="36" Padding="4" Margin="0,0,6,0">
                                                                <ui:SymbolIcon Symbol="Next24" FontSize="15"/>
                                                            </ui:Button>

                                                            <Rectangle Width="1" Fill="#20FFFFFF" Margin="0,6,8,6"/>

                                                            <!-- Secondary Options: Stats, Format, Retry, PiP -->
                                                            <ui:Button x:Name="PlaybackStatsButton" Click="TogglePlaybackStats_Click" ToolTip="Estadísticas de reproducción" AutomationProperties.Name="Estadísticas de reproducción"
                                                                       MinWidth="32" MinHeight="36" Padding="4" Margin="0,0,4,0">
                                                                <ui:SymbolIcon Symbol="DataUsage24" FontSize="15"/>
                                                            </ui:Button>

                                                            <StackPanel Visibility="Collapsed">
                                                                <ComboBox x:Name="AudioTrackBox" Width="80" MinHeight="32" ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}" DisplayMemberPath="Name" DropDownClosed="AudioTrack_Changed"/>
                                                                <ComboBox x:Name="SubtitleTrackBox" Width="80" MinHeight="32" ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay}" DisplayMemberPath="Name" DropDownClosed="SubtitleTrack_Changed"/>
                                                            </StackPanel>

                                                            <ComboBox x:Name="FormatBox" Width="66" MinHeight="34" ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" DropDownClosed="Format_Changed"
                                                                      ToolTip="Formato de emisión (ts / m3u8)" AutomationProperties.Name="Formato de reproducción" Margin="0,0,4,0"/>

                                                            <ui:Button Click="Retry_Click" ToolTip="Reintentar reproducción" AutomationProperties.Name="Reintentar"
                                                                       IsEnabled="{Binding CanRetryPlayback}" MinWidth="32" MinHeight="36" Padding="4" Margin="0,0,4,0">
                                                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15"/>
                                                            </ui:Button>

                                                            <ui:Button x:Name="PlaybackPipButton" Click="TogglePictureInPicture_Click" ToolTip="Ventana flotante PiP (P)" AutomationProperties.Name="Ventana flotante PiP"
                                                                       MinWidth="32" MinHeight="36" Padding="4" Margin="0,0,4,0">
                                                                <ui:SymbolIcon Symbol="PictureInPicture24" FontSize="15"/>
                                                            </ui:Button>

                                                            <!-- Fullscreen -->
                                                            <ui:Button Click="ToggleFullscreen_Click" ToolTip="Pantalla completa (F o doble clic)" AutomationProperties.Name="Pantalla completa"
                                                                       MinWidth="34" MinHeight="36" Padding="4">
                                                                <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="15"/>
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                                <WrapPanel x:Name="PipControls" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <ui:Button Click="TogglePlayPause_Click" ToolTip="{Binding PlayPauseToolTip}" AutomationProperties.Name="{Binding PlayPauseAction}" MinWidth="28" MinHeight="26" Padding="4,2" Margin="0,0,4,0">
                                                        <ui:SymbolIcon Symbol="{Binding PlayPauseSymbol}" FontSize="13"/>
                                                    </ui:Button>
                                                    <ui:Button Click="Previous_Click" ToolTip="Anterior (Shift+P)" AutomationProperties.Name="Anterior" MinWidth="26" MinHeight="26" Padding="4,2" Margin="0,0,4,0">
                                                        <ui:SymbolIcon Symbol="Previous24" FontSize="12"/>
                                                    </ui:Button>
                                                    <ui:Button Click="Next_Click" ToolTip="Siguiente (Shift+N)" AutomationProperties.Name="Siguiente" MinWidth="26" MinHeight="26" Padding="4,2" Margin="0,0,4,0">
                                                        <ui:SymbolIcon Symbol="Next24" FontSize="12"/>
                                                    </ui:Button>
                                                    <ToggleButton IsChecked="{Binding IsMuted, Mode=TwoWay}" ToolTip="Silenciar o activar sonido (M)" AutomationProperties.Name="Silenciar" Background="Transparent" BorderThickness="0" MinWidth="26" MinHeight="26" Padding="4,2" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <ui:SymbolIcon Symbol="{Binding MuteSymbol}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </ToggleButton>
                                                    <ui:Button Content="⏹" Click="Stop_Click" ToolTip="Detener reproducción" AutomationProperties.Name="Detener" IsEnabled="{Binding CanStopPlayback}" MinWidth="26" MinHeight="26" Padding="4,2" Margin="0,0,4,0"/>
                                                    <ui:Button Click="Retry_Click" ToolTip="Reintentar" AutomationProperties.Name="Reintentar" IsEnabled="{Binding CanRetryPlayback}" MinWidth="26" MinHeight="26" Padding="4,2" Margin="0,0,4,0">
                                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12"/>
                                                    </ui:Button>
                                                    <ui:Button Click="TogglePictureInPicture_Click" ToolTip="Volver a ventana normal (Esc o doble clic)" AutomationProperties.Name="Volver a la ventana normal" MinWidth="26" MinHeight="26" Padding="4,2">
                                                        <ui:SymbolIcon Symbol="PictureInPicture24" FontSize="12"/>
                                                    </ui:Button>
                                                </WrapPanel>
                                            </Grid>
                                         </Border>
                                    </StackPanel>
                                    <!-- Modern Netflix/Apple TV style Audio and Subtitles Floating Selector Panel -->
                                    <Border x:Name="AudioSubtitlesOverlay"
                                        Background="#F210141D" BorderBrush="#45FFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="20,16"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,24,106" MaxWidth="540" MinWidth="360" MaxHeight="420"
                                        Visibility="{Binding IsAudioSubtitlesOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="36" ShadowDepth="4" Opacity="0.85" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                                <ui:Button DockPanel.Dock="Right" Click="CloseAudioSubtitles_Click"
                                                    ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar selector de audio y subtítulos"
                                                    Padding="4" MinWidth="28" MinHeight="28" Background="Transparent" BorderThickness="0">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </ui:Button>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="ClosedCaption24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Audio y subtítulos" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Divider -->
                                            <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Fill="#20FFFFFF" Margin="-4,0,-4,0"/>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Column 0: AUDIO -->
                                                <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock DockPanel.Dock="Top" Text="AUDIO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8"/>
                                                    <TextBlock DockPanel.Dock="Top" Text="{Binding AudioStatusMessage}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,8"
                                                        Visibility="{Binding HasNoAudioTracks, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="270">
                                                        <ItemsControl ItemsSource="{Binding FormattedAudioTracks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type core:MediaTrackInfo}">
                                                                    <Button Click="AudioTrackItem_Click" Style="{StaticResource TrackOptionButtonStyle}"
                                                                        ToolTip="{Binding DisplayName}">
                                                                        <DockPanel LastChildFill="True">
                                                                            <ui:SymbolIcon Symbol="Checkmark24" DockPanel.Dock="Right" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </DockPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </DockPanel>
                                                <Rectangle Grid.Column="1" Fill="#30FFFFFF" Width="1" Margin="0,4"/>
                                                <DockPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock DockPanel.Dock="Top" Text="SUBTÍTULOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,8"/>
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="270">
                                                        <ItemsControl ItemsSource="{Binding FormattedSubtitleTracks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type core:MediaTrackInfo}">
                                                                    <Button Click="SubtitleTrackItem_Click" Style="{StaticResource TrackOptionButtonStyle}"
                                                                        ToolTip="{Binding DisplayName}">
                                                                        <DockPanel LastChildFill="True">
                                                                            <ui:SymbolIcon Symbol="Checkmark24" DockPanel.Dock="Right" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </DockPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Grid>
                                            <Border Grid.Row="2" Background="#26FFFFFF" CornerRadius="6" Padding="10,5" Margin="0,10,0,0"
                                                Visibility="{Binding HasAudioSubtitlesFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding AudioSubtitlesFeedback}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                    TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Playback Statistics Floating HUD Panel -->
                                    <Border x:Name="PlaybackStatsOverlay"
                                        Background="#F210141D" BorderBrush="#45FFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="18,16"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,24,106" MaxWidth="380" MinWidth="300"
                                        Visibility="{Binding IsPlaybackStatsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="36" ShadowDepth="4" Opacity="0.85" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <ui:Button DockPanel.Dock="Right" Click="ClosePlaybackStats_Click"
                                                    ToolTip="Cerrar estadísticas (Esc)" AutomationProperties.Name="Cerrar estadísticas de reproducción"
                                                    Padding="4" MinWidth="28" MinHeight="28" Background="Transparent" BorderThickness="0">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </ui:Button>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="DataUsage24" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Estadísticas de reproducción" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Divider -->
                                            <Rectangle Height="1" Fill="#20FFFFFF" Margin="-2,0,-2,12"/>

                                            <!-- Key metrics grid -->
                                            <Grid Margin="2,0,2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Velocidad:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,16,3"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatsBitrateText}" FontWeight="SemiBold" Foreground="White" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Fotogramas (FPS):" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,16,3"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatsFpsText}" FontWeight="SemiBold" Foreground="White" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Búfer efectivo:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,16,3"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatsBufferText}" FontWeight="SemiBold" Foreground="White" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Recargas (pausas):" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,16,3"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StatsRebufferText}" FontWeight="SemiBold" Foreground="White" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Decodificación:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,16,3"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StatsDecoderText}" FontWeight="SemiBold" Foreground="White" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,3"/>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Formato de flujo:" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,16,3"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StatsFormatText}" FontWeight="SemiBold" Foreground="White" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,3"/>
                                            </Grid>

                                            <!-- Technical diagnostic line (preserves compatibility with PlaybackDiagnosticsLabel tests) -->
                                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                                <TextBlock x:Name="PlaybackDiagnosticsLabel" Text="{Binding PlaybackDiagnosticsText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Netflix-style Next Episode Auto-Play Card -->
                                    <Border x:Name="NextEpisodeOverlay"
                                        Background="#F210141D" BorderBrush="#55FFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="20,18"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,24,116" MaxWidth="440" Width="400"
                                        Visibility="{Binding IsNextEpisodeOverlayOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.85" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <ui:Button DockPanel.Dock="Right" Click="CancelNextEpisodeAutoPlay_Click"
                                                    ToolTip="Cancelar reproducción automática (Esc)" AutomationProperties.Name="Cancelar cuenta regresiva"
                                                    Padding="4,2" MinWidth="26" MinHeight="26" Background="Transparent" BorderThickness="0">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </ui:Button>
                                                <TextBlock Text="A CONTINUACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding NextEpisodeSeasonEpisodeLabel}" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding NextEpisodeNameLabel}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding NextEpisodeCountdownLabel}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <ProgressBar Height="5" Minimum="0" Maximum="10" Value="{Binding NextEpisodeProgressValue, Mode=OneWay}"
                                                Foreground="{DynamicResource AccentBrush}" Background="#30FFFFFF" Margin="0,0,0,16"/>
                                            <WrapPanel>
                                                <ui:Button Click="PlayNextEpisodeNow_Click"
                                                    Appearance="Primary" MinHeight="36" Padding="14,6" Margin="0,0,8,0"
                                                    ToolTip="Reproducir inmediatamente" AutomationProperties.Name="Reproducir siguiente episodio">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Reproducir siguiente" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button Content="Cancelar" Click="CancelNextEpisodeAutoPlay_Click"
                                                    MinHeight="36" Padding="12,6" ToolTip="Cancelar reproducción automática" AutomationProperties.Name="Cancelar reproducción automática"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Netflix-style Seasons & Episodes Right-side Drawer Panel -->
                                    <Border x:Name="EpisodesDrawerOverlay"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                        Width="440" MaxWidth="520"
                                        Background="#F510141D" BorderBrush="#40FFFFFF" BorderThickness="1,0,0,0"
                                        Visibility="{Binding IsEpisodesDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.9" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid Margin="18,16,14,16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <!-- Header for Episodes view -->
                                                <DockPanel Visibility="{Binding IsDrawerEpisodesViewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ui:Button DockPanel.Dock="Right" Click="CloseEpisodesDrawer_Click"
                                                        ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar selector de episodios"
                                                        Padding="4" MinWidth="28" MinHeight="28" Background="Transparent" BorderThickness="0">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </ui:Button>
                                                    <ui:Button DockPanel.Dock="Left" Click="SwitchToSeasonsView_Click"
                                                        ToolTip="Cambiar de temporada" AutomationProperties.Name="Seleccionar temporada"
                                                        Padding="8,4" MinHeight="28" Background="#20FFFFFF" BorderThickness="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Temporadas" FontSize="12" VerticalAlignment="Center" Foreground="White"/>
                                                        </StackPanel>
                                                    </ui:Button>
                                                    <TextBlock Text="{Binding DrawerSelectedSeasonName}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>

                                                <!-- Header for Seasons view -->
                                                <DockPanel Visibility="{Binding IsDrawerSeasonsViewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ui:Button DockPanel.Dock="Right" Click="CloseEpisodesDrawer_Click"
                                                        ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar selector de episodios"
                                                        Padding="4" MinWidth="28" MinHeight="28" Background="Transparent" BorderThickness="0">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </ui:Button>
                                                    <ui:Button DockPanel.Dock="Left" Click="SwitchToEpisodesView_Click"
                                                        ToolTip="Volver a los episodios" AutomationProperties.Name="Volver a los episodios"
                                                        Padding="6,4" MinHeight="28" Background="#20FFFFFF" BorderThickness="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="12" VerticalAlignment="Center"/>
                                                    </ui:Button>
                                                    <TextBlock Text="Seleccionar temporada" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Grid>

                                            <!-- Divider -->
                                            <Rectangle Grid.Row="1" Height="1" Fill="#20FFFFFF" Margin="-18,0,-14,12"/>

                                            <!-- Content Body: Episodes View or Seasons View -->
                                            <Grid Grid.Row="2">
                                                <!-- View 1: Episodes list -->
                                                <ScrollViewer Visibility="{Binding IsDrawerEpisodesViewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding DrawerEpisodes}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="DrawerEpisodeItem_Click" Style="{StaticResource DrawerEpisodeCardStyle}"
                                                                        ToolTip="{Binding DisplayTitle}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="110"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Thumbnail & Playing badge overlay -->
                                                                        <Border Grid.Column="0" Height="68" CornerRadius="6" ClipToBounds="True" Background="#FF161A24">
                                                                            <Grid>
                                                                                <local:ChannelLogo Url="{Binding PosterUrl}"
                                                                                    Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                    Stretch="UniformToFill"/>
                                                                                <!-- Fallback icon if no thumbnail -->
                                                                                <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="24" Foreground="#40FFFFFF"
                                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                    IsHitTestVisible="False"/>
                                                                                <!-- Playing badge overlay on thumbnail -->
                                                                                <Border Background="#B3000000" VerticalAlignment="Bottom" Padding="4,2"
                                                                                    Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                                        <ui:SymbolIcon Symbol="Play24" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="EN CURSO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </Grid>

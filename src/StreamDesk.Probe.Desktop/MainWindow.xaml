<ui:FluentWindow x:Class="StreamDesk.Probe.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lvs="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:local="clr-namespace:StreamDesk.Probe.Desktop"
    Title="StreamDesk" Icon="Resources/StreamDesk.ico" Width="1360" Height="850" MinWidth="760" MinHeight="540"
    WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ExtendsContentIntoTitleBar="False" Background="{StaticResource CanvasBrush}">
    <ui:FluentWindow.Resources>
        <local:FavoriteConverter x:Key="FavoriteConverter" />
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#FF15171D"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#FF626B78"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" Opacity="0.7" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,11"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="StarToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="StarBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <ui:SymbolIcon x:Name="StarIcon" Symbol="Star24" FontSize="18" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StarIcon" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="StarIcon" Property="Filled" Value="True"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StarBorder" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="StarBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="SearchableCategoryComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="DropDownToggle" ClickMode="Press" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ToggleBorder" Background="#FF15171D" BorderBrush="#FF626B78" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DataContext.SelectedCategory.Name, RelativeSource={RelativeSource AncestorType=ComboBox}, TargetNullValue='Todas las categorías', FallbackValue='Todas las categorías'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="ToggleBorder" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                       PopupAnimation="Slide" StaysOpen="False">
                    <Border DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="320" Background="#FF1A1D24" BorderBrush="#FF626B78" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.ColumnSpan="3" x:Name="CategoryFilterSearchBox"
                                         Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Buscar categoría..." Padding="26,4,26,4" MinHeight="30" FontSize="12"
                                         AutomationProperties.Name="Buscar categoría"
                                         TextChanged="CategorySearchBox_TextChanged"
                                         PreviewKeyDown="CategorySearchBox_PreviewKeyDown"/>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="7,0,0,0" IsHitTestVisible="False"/>
                                <Button Grid.Column="2" Click="ClearCategorySearch_Click"
                                        Visibility="{Binding HasCategorySearch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="4,2" MinHeight="20"
                                        Background="Transparent" BorderThickness="0" ToolTip="Borrar búsqueda">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="240" CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="SearchableMediaCategoryComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="DropDownToggle" ClickMode="Press" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ToggleBorder" Background="#FF15171D" BorderBrush="#FF626B78" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DataContext.MediaCategory.Name, RelativeSource={RelativeSource AncestorType=ComboBox}, TargetNullValue='Todas las categorías', FallbackValue='Todas las categorías'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="ToggleBorder" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                       PopupAnimation="Slide" StaysOpen="False">
                    <Border DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="320" Background="#FF1A1D24" BorderBrush="#FF626B78" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.ColumnSpan="3" x:Name="MediaCategoryFilterSearchBox"
                                         Text="{Binding MediaCategorySearch, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Buscar categoría..." Padding="26,4,26,4" MinHeight="30" FontSize="12"
                                         AutomationProperties.Name="Buscar categoría de películas o series"
                                         TextChanged="MediaCategorySearchBox_TextChanged"
                                         PreviewKeyDown="MediaCategorySearchBox_PreviewKeyDown"/>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="7,0,0,0" IsHitTestVisible="False"/>
                                <Button Grid.Column="2" Click="ClearMediaCategorySearch_Click"
                                        Visibility="{Binding HasMediaCategorySearch, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="4,2" MinHeight="20"
                                        Background="Transparent" BorderThickness="0" ToolTip="Borrar búsqueda de categoría">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="240" CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
    </ui:FluentWindow.Resources>
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="AppTitleBar" Title="StreamDesk" Grid.Row="0"/>
        <Grid x:Name="Shell" Grid.Row="1" Margin="16" Background="{StaticResource CanvasBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="158"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,12,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Resources/StreamDesk.ico" Width="20" Height="20" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="StreamDesk" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="TV simple y rápida" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,12,0,6">
                    <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <ListBox x:Name="NavigationTabs" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding CurrentTabIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Navegación principal" VerticalAlignment="Top">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Tv24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="TV en vivo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Star24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Favoritos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Recientes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ajustes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsEnabled="{Binding HasMovies}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Películas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsEnabled="{Binding HasSeries}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Series" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Continuar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid x:Name="Workspace" Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="12,20" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="¿Qué quieres ver hoy?" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Text="Haz clic en cualquier canal o película para empezar al instante." FontSize="15" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,24"/>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ÚLTIMO CANAL VISTO" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastChannelLabel}" FontSize="22" TextWrapping="Wrap" Margin="0,8,0,16"/>
                            <WrapPanel>
                                <ui:Button Click="PlayLast_Click" IsEnabled="{Binding HasLastChannel}" Margin="0,0,10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Seguir viendo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Tag="1" Click="Navigate_Click" Margin="0,0,10,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Tv24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ir a TV en vivo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Tag="4" Click="Navigate_Click" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Settings24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Configurar cuenta" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16" Width="250" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="1. Añade tu cuenta" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Ej: https://tuservidor.com:8080" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16" Width="250" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="2. Elige con 1 clic" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Toca cualquier canal para reproducir" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="16" Width="250" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="3. Guarda tus favoritos" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="Marca tus canales preferidos" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="TvPage" Visibility="{Binding ShowTv, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="TvHeader" Margin="0,4,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding SectionTitle}" Style="{StaticResource TypographyPageTitle}"/>
                        <TextBlock Text="{Binding HeaderSummary}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,8,0"/></StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <ComboBox Width="140" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding ActiveProfile, Mode=TwoWay}" ToolTip="Cambiar cuenta activa" AutomationProperties.Name="Perfil activo" Margin="0,0,8,0"/>
                        <ui:Button Command="{Binding LoadCatalogCommand}" ToolTip="Actualizar canales en vivo">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Canales" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Click="ProbeContent_Click" IsEnabled="{Binding CanConnect}" ToolTip="Cargar catálogo de películas y series" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Películas/Series" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="PipButton" Click="TogglePictureInPicture_Click" IsEnabled="{Binding ShowPlayerPane}" ToolTip="Modo ventana flotante (P)" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Pin24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Flotante" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </WrapPanel>
                </Grid>
                <StackPanel x:Name="ConnectionNotices" Grid.Row="1">
                    <TextBlock Text="{Binding HttpWarning}" Visibility="{Binding HasHttpWarning, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#FFFFCF72" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Expander Header="Importar lista M3U/M3U8" Visibility="{Binding ShowLiveCatalog, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,6">
                        <StackPanel Margin="8,4">
                            <TextBlock Text="La lista solo se conserva durante esta sesión. Vuelve a importarla al reiniciar." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <WrapPanel VerticalAlignment="Center">
                                <ui:Button Click="ImportPlaylistFile_Click" IsEnabled="{Binding CanImportPlaylist}" Margin="0,0,8,6" ToolTip="Importar un archivo .m3u o .m3u8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Abrir archivo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <TextBox x:Name="RemotePlaylistBox" Text="{Binding RemotePlaylistUrl, UpdateSourceTrigger=PropertyChanged}" Tag="https://ejemplo.com/lista.m3u8" Width="320" MaxWidth="460" UndoLimit="0" AutomationProperties.Name="Dirección de la lista M3U" Margin="0,0,8,6"/>
                                <ui:Button Click="ImportPlaylistUrl_Click" IsEnabled="{Binding CanImportPlaylist}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Globe24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Importar URL" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <TextBlock Text="{Binding PlaylistStatus}" Visibility="{Binding HasPlaylistStatus, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,6"/>
                    <ui:Button Click="CancelCatalog_Click" Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancelar carga" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
                <Grid Grid.Row="2" x:Name="TvLayout">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="284"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid x:Name="CatalogPane">
                    <Border Padding="12" CornerRadius="10" Background="{StaticResource SurfaceBrush}" Margin="0,0,14,0" Visibility="{Binding ShowLiveCatalog, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Buscar canal (ej. Deportes, Noticias)..." Padding="10,6,32,6" AutomationProperties.Name="Buscar canal"/>
                                <Button Click="ClearSearch_Click" Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="6,2" MinHeight="24" Background="Transparent" BorderThickness="0" ToolTip="Borrar búsqueda">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>

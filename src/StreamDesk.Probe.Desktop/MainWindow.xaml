                                                    <Border CornerRadius="6" ClipToBounds="True" Background="#FF161A24" Width="64" Height="88" VerticalAlignment="Center">
                                                        <Grid>
                                                            <local:ChannelLogo Url="{Binding Item.PosterUrl}" Loader="{Binding LogoLoader, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Stretch="UniformToFill" DecodeWidth="140" DecodeHeight="190"/>
                                                            <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="22" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Item.Name}" FontSize="16" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,8"/>
                                                        <ProgressBar Height="4" Minimum="0" Maximum="{Binding DurationMilliseconds}" Value="{Binding PositionMilliseconds}"
                                                                     Foreground="{DynamicResource AccentBrush}" Background="#30FFFFFF" BorderThickness="0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Click="PlayMedia_Click" ToolTip="Reanudar reproducción" Appearance="Primary" Padding="12,6" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Reanudar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ui:Button>

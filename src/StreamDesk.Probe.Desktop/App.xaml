<Application x:Class="StreamDesk.Probe.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#FF101116" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1B1D23" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF232630" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF70D6B2" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F4F7" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FFB9C4D0" />
            <Thickness x:Key="SpaceSmall">8</Thickness>
            <Thickness x:Key="SpaceMedium">16</Thickness>
            <Thickness x:Key="SpaceLarge">24</Thickness>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="TypographyPageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="TypographyHero" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

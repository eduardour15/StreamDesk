<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StreamDesk.Probe.Core\StreamDesk.Probe.Core.csproj" />
    <ProjectReference Include="..\StreamDesk.Application\StreamDesk.Application.csproj" />
    <ProjectReference Include="..\StreamDesk.Probe.Infrastructure\StreamDesk.Probe.Infrastructure.csproj" />
    <ProjectReference Include="..\StreamDesk.Probe.Playback\StreamDesk.Probe.Playback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <!-- The executable owns the native VLC payload; transitive package assets from Playback are not copied here. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Keep WPF generated-source handling deterministic when project references build. -->
    <BuildInParallel>false</BuildInParallel>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\StreamDesk.ico</ApplicationIcon>
    <Company>eduardour15</Company>
    <Authors>eduardour15</Authors>
    <Copyright>Copyright © 2026 eduardour15</Copyright>
    <Product>StreamDesk</Product>
    <Version>0.5.0-rc.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\StreamDesk.ico" />
  </ItemGroup>

</Project>
